From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] luci-mod-system: saving an empty password removes it

Saving the Router Password page with both fields empty did nothing and
said nothing: the old password stayed, and the only way back to a
password-less root was `passwd -d root` over SSH. Users expect an empty
password to be something they can choose, as on most systems.

With both fields empty, Save now asks whether to remove the password,
and on confirmation runs `passwd -d root` and reports the result.
Cancel leaves the password as it is.

The page may run /bin/passwd for users who may already set the password
(luci-mod-system-config write).

---
--- a/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
+++ b/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
@@ -4,6 +4,7 @@
 'require ui';
 'require form';
 'require rpc';
+'require fs';
 
 var formData = {
 	password: {
@@ -72,8 +73,31 @@
 		var map = document.querySelector('.cbi-map');
 
 		return dom.callClassMethod(map, 'save').then(function() {
-			if (formData.password.pw1 == null || formData.password.pw1.length == 0)
-				return;
+			var pw1 = formData.password.pw1 || '', pw2 = formData.password.pw2 || '';
+
+			/* Both fields empty: the user wants no password - ask, then remove it. */
+			if (pw1.length == 0 && pw2.length == 0) {
+				return new Promise(function(resolve) {
+					ui.showModal(_('Remove the router password?'), [
+						E('p', _('Both fields are empty. Without a password, anyone who can reach this router can log in as root and change its settings.')),
+						E('div', { 'class': 'right' }, [
+							E('button', { 'class': 'btn', 'click': function() { ui.hideModal(); resolve(); } }, _('Cancel')), ' ',
+							E('button', { 'class': 'btn cbi-button-negative', 'click': function() {
+								fs.exec('/bin/passwd', [ '-d', 'root' ]).then(function(res) {
+									ui.hideModal();
+									if (res.code == 0)
+										ui.addNotification(null, E('p', _('The router password has been removed.')), 'info');
+									else
+										ui.addNotification(null, E('p', _('Failed to remove the router password.')), 'danger');
+								}).catch(function(e) {
+									ui.hideModal();
+									ui.addNotification(null, E('p', _('Failed to remove the router password.') + ' ' + e), 'danger');
+								}).then(resolve);
+							} }, _('Remove password'))
+						])
+					]);
+				});
+			}
 
 			if (formData.password.pw1 != formData.password.pw2) {
 				ui.addNotification(null, E('p', _('Given password confirmation did not match, password not changed!')), 'danger');
--- a/modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json
+++ b/modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json
@@ -9,6 +9,9 @@
 			"uci": [ "luci", "system" ]
 		},
 		"write": {
+			"file": {
+				"/bin/passwd": [ "exec" ]
+			},
 			"ubus": {
 				"luci": [ "setLocaltime", "setPassword" ],
 				"rc": [ "init" ]
