From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] luci-mod-system: a button to remove the router password

Saving the Router Password page with empty fields does nothing and says
nothing: the old password stays, and the only way back to a password-less
root is `passwd -d root` over SSH. Users expect an empty password to be
something they can choose, as on most systems.

Add a "Remove password" button below the form. It asks for confirmation,
runs `passwd -d root` and reports the result. Saving empty fields keeps
its old meaning (the password is left as it is), so nobody removes the
password by pressing Save on an empty form.

The page may run /bin/passwd for users who may already set the password
(luci-mod-system-config write).

---
--- a/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
+++ b/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
@@ -4,6 +4,7 @@
 'require ui';
 'require form';
 'require rpc';
+'require fs';
 
 var formData = {
 	password: {
@@ -65,6 +66,34 @@
 			return node;
 		};
 
+		s = m.section(form.NamedSection, 'password', 'password', _('No password'),
+			_('Saving empty fields keeps the current password. To let root log in without a password again (LuCI and SSH), remove it here.'));
+
+		o = s.option(form.Button, '_remove', _('Remove password'));
+		o.inputtitle = _('Remove password');
+		o.inputstyle = 'remove';
+		o.onclick = function() {
+			ui.showModal(_('Remove the router password?'), [
+				E('p', _('Anyone who can reach this router will be able to log in as root and change its settings.')),
+				E('div', { 'class': 'right' }, [
+					E('button', { 'class': 'btn', 'click': ui.hideModal }, _('Cancel')), ' ',
+					E('button', { 'class': 'btn cbi-button-negative', 'click': function() {
+						return fs.exec('/bin/passwd', [ '-d', 'root' ]).then(function(res) {
+							ui.hideModal();
+							if (res.code == 0) {
+								ui.addNotification(null, E('p', _('The router password has been removed.')), 'info');
+							} else {
+								ui.addNotification(null, E('p', _('Failed to remove the router password.')), 'danger');
+							}
+						}).catch(function(e) {
+							ui.hideModal();
+							ui.addNotification(null, E('p', _('Failed to remove the router password.') + ' ' + e), 'danger');
+						});
+					} }, _('Remove password'))
+				])
+			]);
+		};
+
 		return m.render();
 	},
 
--- a/modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json
+++ b/modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json
@@ -9,6 +9,9 @@
 			"uci": [ "luci", "system" ]
 		},
 		"write": {
+			"file": {
+				"/bin/passwd": [ "exec" ]
+			},
 			"ubus": {
 				"luci": [ "setLocaltime", "setPassword" ],
 				"rc": [ "init" ]
