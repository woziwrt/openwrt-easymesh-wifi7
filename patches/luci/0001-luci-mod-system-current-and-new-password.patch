From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] luci-mod-system: current and new password; empty removes it

The Router Password page set a new password without asking for the
current one, and saving it empty did nothing and said nothing: the old
password stayed, and only `passwd -d root` over SSH brought back a
password-less root.

The page now works the way most systems do:
- "Current password" is checked first (left empty when the router has
  none); a wrong one changes nothing and says so.
- "New password" + "Confirmation" set the new password.
- Both left empty remove the password, after a confirmation dialog.

The page may run /bin/passwd for users who may already set the password
(luci-mod-system-config write).

---
--- a/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
+++ b/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
@@ -4,14 +4,23 @@
 'require ui';
 'require form';
 'require rpc';
+'require fs';
 
 var formData = {
 	password: {
+		pw0: null,
 		pw1: null,
 		pw2: null
 	}
 };
 
+/* Checks the current password the way the login page does. */
+var callLogin = rpc.declare({
+	object: 'session',
+	method: 'login',
+	params: [ 'username', 'password' ]
+});
+
 var callSetPassword = rpc.declare({
 	object: 'luci',
 	method: 'setPassword',
@@ -48,7 +57,10 @@
 
 		s = m.section(form.NamedSection, 'password', 'password');
 
-		o = s.option(form.Value, 'pw1', _('Password'));
+		o = s.option(form.Value, 'pw0', _('Current password'), _('Leave empty if the router has no password.'));
+		o.password = true;
+
+		o = s.option(form.Value, 'pw1', _('New password'), _('Leave both fields empty to remove the password.'));
 		o.password = true;
 		o.validate = this.checkPassword;
 
@@ -71,25 +83,53 @@
 	handleSave: function() {
 		var map = document.querySelector('.cbi-map');
 
+		function done(ok, msg) {
+			ui.addNotification(null, E('p', msg), ok ? 'info' : 'danger');
+			formData.password.pw0 = null;
+			formData.password.pw1 = null;
+			formData.password.pw2 = null;
+			dom.callClassMethod(map, 'render');
+		}
+
 		return dom.callClassMethod(map, 'save').then(function() {
-			if (formData.password.pw1 == null || formData.password.pw1.length == 0)
-				return;
+			var pw0 = formData.password.pw0 || '',
+			    pw1 = formData.password.pw1 || '',
+			    pw2 = formData.password.pw2 || '';
 
-			if (formData.password.pw1 != formData.password.pw2) {
+			if (pw1 != pw2) {
 				ui.addNotification(null, E('p', _('Given password confirmation did not match, password not changed!')), 'danger');
 				return;
 			}
 
-			return callSetPassword('root', formData.password.pw1).then(function(success) {
-				if (success)
-					ui.addNotification(null, E('p', _('The system password has been successfully changed.')), 'info');
-				else
-					ui.addNotification(null, E('p', _('Failed to change the system password.')), 'danger');
-
-				formData.password.pw1 = null;
-				formData.password.pw2 = null;
-
-				dom.callClassMethod(map, 'render');
+			return callLogin('root', pw0).then(function(res) {
+				if (!res || typeof(res) != 'object' || !res.ubus_rpc_session)
+					return done(false, _('The current password is wrong - nothing changed.'));
+
+				if (pw1.length > 0)
+					return callSetPassword('root', pw1).then(function(success) {
+						done(success, success ? _('The system password has been successfully changed.')
+						                      : _('Failed to change the system password.'));
+					});
+
+				/* New password left empty: remove the password, after a question. */
+				return new Promise(function(resolve) {
+					ui.showModal(_('Remove the router password?'), [
+						E('p', _('The new password is empty. Without a password, anyone who can reach this router can log in as root and change its settings.')),
+						E('div', { 'class': 'right' }, [
+							E('button', { 'class': 'btn', 'click': function() { ui.hideModal(); resolve(); } }, _('Cancel')), ' ',
+							E('button', { 'class': 'btn cbi-button-negative', 'click': function() {
+								fs.exec('/bin/passwd', [ '-d', 'root' ]).then(function(r) {
+									ui.hideModal();
+									done(r.code == 0, r.code == 0 ? _('The router password has been removed.')
+									                              : _('Failed to remove the router password.'));
+								}).catch(function(e) {
+									ui.hideModal();
+									done(false, _('Failed to remove the router password.') + ' ' + e);
+								}).then(resolve);
+							} }, _('Remove password'))
+						])
+					]);
+				});
 			});
 		});
 	},
--- a/modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json
+++ b/modules/luci-mod-system/root/usr/share/rpcd/acl.d/luci-mod-system.json
@@ -9,6 +9,9 @@
 			"uci": [ "luci", "system" ]
 		},
 		"write": {
+			"file": {
+				"/bin/passwd": [ "exec" ]
+			},
 			"ubus": {
 				"luci": [ "setLocaltime", "setPassword" ],
 				"rc": [ "init" ]
