+	/* Update new & changed nbr entries in driver (async del + add). */
+	list_for_each_entry(n, &ap->nbrlist, list) {
+		struct blob_buf bb = {};
+		char bssidstr[18] = {};
+		char bssid_infostr[12] = {};
+
+		if (n->flags & NBR_FLAG_DRV_UPDATED)
+			continue;
+
+		dbg("[%s] Update neighbor " MACFMT " entry in driver\n",
+		    ap->ifname, MAC2STR(n->nbr.bssid));
+
+		hwaddr_ntoa(n->nbr.bssid, bssidstr);
+
+		/* del first (mirrors the sync del+add pair) */
+		blob_buf_init(&bb, 0);
+		blobmsg_add_string(&bb, "bssid", bssidstr);
+		agent_wifi_fire(a, ap->obj_id, NULL, "del_neighbor", &bb);
+		blob_buf_free(&bb);
+
+		snprintf(bssid_infostr, sizeof(bssid_infostr), "%u",
+			 n->nbr.bssid_info);
+		blob_buf_init(&bb, 0);
+		blobmsg_add_string(&bb, "bssid", bssidstr);
+		blobmsg_add_u32(&bb, "channel", n->nbr.channel);
+		blobmsg_add_string(&bb, "bssid_info", bssid_infostr);
+		blobmsg_add_u32(&bb, "reg", n->nbr.reg);
+		blobmsg_add_u32(&bb, "phy", n->nbr.phy);
+		agent_wifi_fire(a, ap->obj_id, NULL, "add_neighbor", &bb);
+		blob_buf_free(&bb);
+
+		n->flags |= NBR_FLAG_DRV_UPDATED;
+	}
+
