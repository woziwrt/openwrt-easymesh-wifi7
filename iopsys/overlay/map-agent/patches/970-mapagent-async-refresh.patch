+	w->a = a;
+	snprintf(w->ifname, sizeof(w->ifname), "%s", ap->ifname);
+	snprintf(objname, sizeof(objname), "wifi.ap.%s", ap->ifname);
+
+	if (agent_wifi_async(a, &w->areq, objname, ap->obj_id, "list_neighbor",
+			     nbr_list_data_cb, nbr_list_complete,
+			     nbr_list_timeout, w, 1 * 1000)) {
+		ap->nbr_refresh_inflight = false;
+		free(w);
+	}
+}
