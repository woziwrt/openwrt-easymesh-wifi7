From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] map-agent: apply SSID/PSK changes to every affiliated link of an AP MLD

set_ap_ssid() and set_ap_psk() talk to a single hostapd control interface.
On an AP MLD that interface serves only the first affiliated link, so a
credential change reaches one link and leaves the others advertising the
old value - one MLD ends up with a different SSID per link.

Measured on BPI-R4 (mt7996, 3-link AP MLD, OpenWrt 25.12):

  multiap set_ap_ssid ap-mld-1 <new>
    link0 -> <new>          link1 -> old          link2 -> old

This is why partial_wifi_reload defaults to 0: the partial path predates
MLD, and enabling it would desynchronise the links. The fallback is
wireless_reload(), which on anything but ath12k runs a bare "wifi" -
that is "wifi up", i.e. a full down/reload/up of every radio.

Iterate over the per-link control sockets instead. hostapd creates
/var/run/hostapd/<ifname>_link<N> for each affiliated link; when none
exist the interface is not an MLD and the single socket is used, so
non-MLD setups are unaffected.

The STOP_AP/UPDATE_BEACON/reload block moves into apply_to_bss() so both
callers share it.

Measured effect of the loop (same board, 3-link AP MLD, one hop to the
controller over a wireless backhaul):

                      looped partial      wifi down/up
  command returns     1 s                 async
  all links updated   6 s                 25-30 s
  link state          ENABLED throughout  bounce
  backhaul            never dropped       drops and re-associates
  mesh reachability   OK throughout       lost, then stale ARP
  ubus get_status     rc=0 throughout     unavailable while down
  hostapd             not restarted       restarted

UPDATE_BEACON returns FAIL on the links whose AP is already stopped;
the trailing reload applies the change regardless. Left as is - matching
the existing behaviour of the single-interface path.

Signed-off-by: Petr Wozniak <petr.wozniak@gmail.com>
---
--- a/src/script/multiap
+++ b/src/script/multiap
@@ -398,46 +398,62 @@
 	uci commit wireless
 }
 
-set_ap_ssid() {
+# List the hostapd control interfaces to act on for an AP interface.
+# An AP MLD is served by one socket per affiliated link; talking only to the
+# MLD socket updates the first link and leaves the others on the old value.
+hostapd_ifnames() {
 	local ifname=$1
-	local ssid=$2
-	local brcm_setup="$(uci -q get mapagent.agent.brcm_setup)"
+	local links="" link
 
-	[ -n "$ifname" -o -n "$ssid" ] || return
+	for link in /var/run/hostapd/"$ifname"_link*; do
+		[ -S "$link" ] || continue
+		links="$links ${link##*/}"
+	done
 
-	logger -t multiap "set_ap_ssid $ifname $ssid"
-	hostapd_cli -i $ifname set ssid $ssid
+	echo "${links:-$ifname}"
+}
+
+apply_to_bss() {
+	local ctrl=$1
+	local brcm_setup="$(uci -q get mapagent.agent.brcm_setup)"
 
 	if [ "$brcm_setup" = "1" ]; then
-		hostapd_cli -i $ifname raw STOP_BSS
-		hostapd_cli -i $ifname raw UPDATE_BEACON
-		hostapd_cli -i $ifname raw START_BSS
+		hostapd_cli -i $ctrl raw STOP_BSS
+		hostapd_cli -i $ctrl raw UPDATE_BEACON
+		hostapd_cli -i $ctrl raw START_BSS
 	else
-		hostapd_cli -i $ifname raw STOP_AP
-		hostapd_cli -i $ifname raw UPDATE_BEACON
-		hostapd_cli -i $ifname reload
+		hostapd_cli -i $ctrl raw STOP_AP
+		hostapd_cli -i $ctrl raw UPDATE_BEACON
+		hostapd_cli -i $ctrl reload
 	fi
 }
 
+set_ap_ssid() {
+	local ifname=$1
+	local ssid=$2
+	local ctrl
+
+	[ -n "$ifname" -o -n "$ssid" ] || return
+
+	logger -t multiap "set_ap_ssid $ifname $ssid"
+	for ctrl in $(hostapd_ifnames $ifname); do
+		hostapd_cli -i $ctrl set ssid $ssid
+		apply_to_bss $ctrl
+	done
+}
+
 set_ap_psk() {
 	local ifname=$1
 	local psk=$2
-	local brcm_setup="$(uci -q get mapagent.agent.brcm_setup)"
+	local ctrl
 
 	[ -n "$ifname" -o -n "$psk" ] || return
 
 	logger -t multiap "set_ap_psk $ifname $psk"
-	hostapd_cli -i $ifname set wpa_passphrase $psk
-
-	if [ "$brcm_setup" = "1" ]; then
-		hostapd_cli -i $ifname raw STOP_BSS
-		hostapd_cli -i $ifname raw UPDATE_BEACON
-		hostapd_cli -i $ifname raw START_BSS
-	else
-		hostapd_cli -i $ifname raw STOP_AP
-		hostapd_cli -i $ifname raw UPDATE_BEACON
-		hostapd_cli -i $ifname reload
-	fi
+	for ctrl in $(hostapd_ifnames $ifname); do
+		hostapd_cli -i $ctrl set wpa_passphrase $psk
+		apply_to_bss $ctrl
+	done
 }
 
 config_reorder() {
