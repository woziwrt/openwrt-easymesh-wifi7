-	.register_event = nlwifi_register_event,
-	.unregister_event = nlwifi_unregister_event,
-	.recv_event = nlwifi_recv_event,
+	.register_event = wifi_dispatch_register_event,
+	.unregister_event = wifi_dispatch_unregister_event,
+	.recv_event = wifi_dispatch_recv_event,
 };
