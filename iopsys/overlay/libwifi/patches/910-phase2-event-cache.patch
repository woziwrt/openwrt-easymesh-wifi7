From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] libwifi: phase2 event cache
Signed-off-by: Petr Wozniak <petr.wozniak@gmail.com>

--- a/libwifi/modules/wpactrl/wpactrl.h
+++ b/libwifi/modules/wpactrl/wpactrl.h
@@ -2,6 +2,8 @@
 #ifndef WPACTRL_H
 #define WPACTRL_H
 
+#include <easy/event.h>	/* struct event_struct */
+
 #define WPACTRL_TIMEOUT 5
 
 int hostapd_cli_set(const char *ifname, const char *cmd, bool check_ok);
@@ -12,4 +14,10 @@
 int wpa_ctrl_iface_get(const char *ifname, const char *cmd, char *out, size_t out_size, bool isHostapd);
 int wpa_ctrl_get_param(const char *buf, const char *param, char *value, size_t value_max);
 
+/* Phase-2 bSTA event source (rides wifimngr's fd_monitor->uloop; no thread).
+ * Same signature family as nlwifi_*_event so wifi.c can dispatch on req->family. */
+int wpactrl_register_event(const char *ifname, struct event_struct *req, void **handle);
+int wpactrl_recv_event(const char *ifname, void *handle);
+int wpactrl_unregister_event(const char *ifname, void *handle);
+
 #endif
--- a/libwifi/modules/wpactrl/wpactrl.c
+++ b/libwifi/modules/wpactrl/wpactrl.c
@@ -24,6 +24,7 @@
 #include "wifi.h"
 #include "debug.h"
 #include "wpactrl.h"
+#include "staconn_cache.h"
 
 #ifdef LIBWIFI_USE_CTRL_IFACE
 #include "limits.h"
@@ -380,6 +381,301 @@
 	return wpa_ctrl_iface_get(ifname, cmd, out, out_size, false);
 }
 
+/* ---- Phase-2: attach/pending/recv quartet (ported from wpa_supplicant
+ * wpa_ctrl.c, LGPL-compatible) + a persistent event source that feeds the
+ * process-local bSTA connection-state cache.
+ *
+ * Placed here so the file-local statics it reuses (wpa_ctrl_open/close/request,
+ * wpa_cli_get) are already defined above. ------------------------------- */
+
+/* ATTACH/DETACH: after ATTACH wpa_supplicant multicasts "<n>CTRL-EVENT-*".
+ * Reuses the file-local wpa_ctrl_request(), which already skips unsolicited
+ * '<'-prefixed frames and returns the solicited "OK" reply. */
+static int wpa_ctrl_attach_helper(struct wpa_ctrl *ctrl, bool attach)
+{
+	char buf[16] = {};
+	size_t len = sizeof(buf);
+	int ret;
+
+	ret = wpa_ctrl_request(ctrl, attach ? "ATTACH" : "DETACH", 6, buf, &len);
+	if (ret < 0)
+		return ret;
+	if (len >= 2 && !memcmp(buf, "OK", 2))
+		return 0;
+	return -1;
+}
+
+static int wpa_ctrl_attach(struct wpa_ctrl *ctrl)
+{
+	return wpa_ctrl_attach_helper(ctrl, true);
+}
+
+static int wpa_ctrl_detach(struct wpa_ctrl *ctrl)
+{
+	return wpa_ctrl_attach_helper(ctrl, false);
+}
+
+/* >0: a message is queued, 0: none, <0: select error (socket bad). */
+static int wpa_ctrl_pending(struct wpa_ctrl *ctrl)
+{
+	struct timeval tv = { .tv_sec = 0, .tv_usec = 0 };
+	fd_set rfds;
+	int res;
+
+	FD_ZERO(&rfds);
+	FD_SET(ctrl->s, &rfds);
+	res = select(ctrl->s + 1, &rfds, NULL, NULL, &tv);
+	if (res < 0)
+		return res;
+	return FD_ISSET(ctrl->s, &rfds) ? 1 : 0;
+}
+
+static int wpa_ctrl_recv(struct wpa_ctrl *ctrl, char *reply, size_t *reply_len)
+{
+	int res;
+
+	res = recv(ctrl->s, reply, *reply_len, 0);
+	if (res < 0)
+		return res;
+	*reply_len = res;
+	return 0;
+}
+
+/* Max consecutive recv/re-open failures before we stop trying (prevents a
+ * dead fd from busy-looping through wifimngr's delete+add re-arm). */
+#define WPACTRL_MAX_FAILS	5
+
+/* Persistent event handle (mirrors nlwifi's per-registration state). */
+struct wpactrl_event {
+	struct event_struct req;	/* copy, like nlwifi_event */
+	struct wpa_ctrl *ctrl;		/* second, attached handle (may be NULL) */
+	char ifname[16];
+	int fails;			/* consecutive recv/reopen failures */
+	bool dead;			/* gave up; do not re-arm-spin */
+};
+
+/* One sync STATUS -> cache. Gated on wpa_state==COMPLETED for the connected
+ * fields; keeps last bssid on the not-yet-completed path. Reuses the transient
+ * wpa_cli_get() socket, so it does not disturb the persistent attached one. */
+static void staconn_seed_from_status(const char *ifname)
+{
+	char buf[1024] = {};
+	char val[128] = {};
+	struct bsta_conn e = {};
+
+	strncpy(e.ifname, ifname, sizeof(e.ifname) - 1);
+
+	if (wpa_cli_get(ifname, "status", buf, sizeof(buf)))
+		return;
+
+	if (wpa_ctrl_get_param(buf, "wpa_state", val, sizeof(val)) ||
+	    strcmp(val, "COMPLETED")) {
+		/* not (yet) associated: preserve last-known bssid, mark down */
+		staconn_cache_get(ifname, &e);
+		strncpy(e.ifname, ifname, sizeof(e.ifname) - 1);
+		e.connected = false;
+		staconn_cache_update(&e);
+		return;
+	}
+
+	e.connected = true;
+
+	if (!wpa_ctrl_get_param(buf, "bssid", val, sizeof(val)))
+		hwaddr_aton(val, e.bssid);
+
+	if (!wpa_ctrl_get_param(buf, "ssid", val, sizeof(val))) {
+		strncpy((char *)e.ssid, val, sizeof(e.ssid) - 1);
+		e.ssidlen = strlen((char *)e.ssid);
+	}
+
+	if (!wpa_ctrl_get_param(buf, "freq", val, sizeof(val))) {
+		e.freq = (uint32_t)atoi(val);
+		if (e.freq) {
+			e.channel = wifi_freq_to_channel(e.freq);
+			e.band = wifi_freq_to_band(e.freq);
+		}
+	}
+
+	staconn_cache_update(&e);
+}
+
+/* Atomic cache mutator for a parsed CTRL-EVENT line. */
+struct staconn_ev {
+	bool connected;
+	bool has_reason;
+	uint16_t reason;
+};
+
+static void staconn_cb_event(struct bsta_conn *e, void *ctx)
+{
+	struct staconn_ev *ev = ctx;
+
+	e->connected = ev->connected;		/* keep last bssid on down */
+	if (ev->has_reason)
+		e->last_reason = ev->reason;
+}
+
+/* Parse one "<n>CTRL-EVENT-*" line and mutate the cache (atomic RMW). */
+static void staconn_parse_event(const char *ifname, const char *msg)
+{
+	struct staconn_ev ev = {};
+	char *p;
+
+	if (strstr(msg, "CTRL-EVENT-CONNECTED")) {
+		ev.connected = true;
+		staconn_cache_apply(ifname, staconn_cb_event, &ev);
+		/* fill ssid/freq/bssid authoritatively, gated on COMPLETED */
+		staconn_seed_from_status(ifname);
+	} else if (strstr(msg, "CTRL-EVENT-DISCONNECTED")) {
+		ev.connected = false;
+		if ((p = strstr(msg, "reason="))) {
+			ev.has_reason = true;
+			ev.reason = (uint16_t)atoi(p + 7);
+		}
+		staconn_cache_apply(ifname, staconn_cb_event, &ev);
+	} else if (strstr(msg, "CTRL-EVENT-ASSOC-REJECT")) {
+		ev.connected = false;
+		if ((p = strstr(msg, "status_code="))) {
+			ev.has_reason = true;
+			ev.reason = (uint16_t)atoi(p + 12);
+		}
+		staconn_cache_apply(ifname, staconn_cb_event, &ev);
+	}
+}
+
+/* Best-effort (re)open + ATTACH of the persistent handle. On success the
+ * stored ctrl and req.fd_monitor are refreshed and the cache is re-seeded.
+ * Closing before re-opening makes the kernel hand back the same fd number in
+ * the common case, so wifimngr's re-arm (which re-adds the old fd number)
+ * transparently picks up the fresh socket. Returns 0 on success, -1 on fail. */
+static int wpactrl_reopen(struct wpactrl_event *w)
+{
+	char cfile[256] = {};
+
+	if (w->ctrl) {
+		wpa_ctrl_close(w->ctrl);
+		w->ctrl = NULL;
+	}
+
+	snprintf(cfile, sizeof(cfile), "%s/%s",
+		 CONFIG_WPA_CTRL_IFACE_DIR, w->ifname);
+	w->ctrl = wpa_ctrl_open(cfile);
+	if (!w->ctrl)
+		return -1;
+
+	if (wpa_ctrl_attach(w->ctrl)) {
+		wpa_ctrl_close(w->ctrl);
+		w->ctrl = NULL;
+		return -1;
+	}
+
+	w->req.fd_monitor = w->ctrl->s;
+	staconn_seed_from_status(w->ifname);
+	return 0;
+}
+
+int wpactrl_register_event(const char *ifname, struct event_struct *req, void **handle)
+{
+	struct wpactrl_event *w;
+
+	libwifi_dbg("%s %s called family %s group %s\n", ifname, __func__,
+		    req->family, req->group);
+
+	w = calloc(1, sizeof(*w));
+	if (!w) {
+		libwifi_err("%s: calloc failed\n", __func__);
+		return -1;
+	}
+	memcpy(&w->req, req, sizeof(struct event_struct));
+	strncpy(w->ifname, ifname, sizeof(w->ifname) - 1);
+
+	/* MAJOR-4: if the bsta ctrl socket is not up yet, do NOT hard-fail --
+	 * register a dormant source. The cache is still populated by the
+	 * nl80211/mlme CONNECT handler + the supplicant STATUS write-through,
+	 * so Engine B is a best-effort optimisation. When dormant we leave
+	 * req->fd_monitor == 0, so wifimngr adds no uloop fd for it; the source
+	 * re-attaches on the next (re)register / supplicant event. */
+	if (wpactrl_reopen(w) != 0)
+		libwifi_warn("%s: %s ctrl socket not ready; wpactrl source dormant\n",
+			     ifname, __func__);
+
+	/* wifimngr reads the caller's req->fd_monitor, not our internal copy. */
+	req->fd_monitor = w->ctrl ? w->ctrl->s : 0;
+
+	*handle = w;
+	return 0;
+}
+
+int wpactrl_recv_event(const char *ifname, void *handle)
+{
+	struct wpactrl_event *w = handle;
+	char buf[4096];
+	size_t len;
+	int pending;
+
+	/* No source or we already gave up: return a non-ENETDOWN negative so
+	 * wifimngr ends its recv loop and does NOT re-arm -> no busy-loop. */
+	if (!w || w->dead)
+		return -EAGAIN;
+
+	if (!w->ctrl) {
+		/* dormant (socket was late) or a prior reopen failed: retry now */
+		if (wpactrl_reopen(w) == 0) {
+			w->fails = 0;
+			return -ENETDOWN;	/* re-arm to monitor the fd */
+		}
+		if (++w->fails >= WPACTRL_MAX_FAILS)
+			w->dead = true;
+		return -EAGAIN;			/* nothing to read; stop */
+	}
+
+	/* EDGE_TRIGGER: drain everything queued in this one wakeup. */
+	while ((pending = wpa_ctrl_pending(w->ctrl)) > 0) {
+		len = sizeof(buf) - 1;
+		if (wpa_ctrl_recv(w->ctrl, buf, &len) < 0)
+			goto recover;
+		buf[len] = '\0';
+		staconn_parse_event(ifname, buf);
+	}
+	if (pending < 0)
+		goto recover;
+
+	w->fails = 0;
+	return -EAGAIN;				/* drained cleanly */
+
+recover:
+	/* MAJOR-3: ctrl socket died (supplicant restart). Drop to the sync/TTL
+	 * fallback, and re-open + re-ATTACH in place (best-effort). A bounded
+	 * failure count turns the source off after WPACTRL_MAX_FAILS so a dead
+	 * fd cannot busy-loop through wifimngr's delete+add re-arm. */
+	staconn_cache_invalidate(ifname);
+	if (++w->fails >= WPACTRL_MAX_FAILS) {
+		w->dead = true;
+		libwifi_err("%s: %s giving up after %d consecutive failures\n",
+			    ifname, __func__, w->fails);
+		return -EAGAIN;			/* stop the re-arm spin */
+	}
+	wpactrl_reopen(w);			/* best-effort; reuses fd number */
+	return -ENETDOWN;			/* let wifimngr re-arm once */
+}
+
+int wpactrl_unregister_event(const char *ifname, void *handle)
+{
+	struct wpactrl_event *w = handle;
+
+	libwifi_dbg("%s %s called\n", ifname, __func__);
+
+	if (!w)
+		return -1;
+
+	if (w->ctrl) {
+		wpa_ctrl_detach(w->ctrl);
+		wpa_ctrl_close(w->ctrl);
+	}
+	free(w);
+	return 0;
+}
+
 #else
 int hostapd_cli_set(const char *ifname, const char *cmd, bool check_ok)
 {
@@ -474,6 +770,25 @@
 	(void) isHostapd;
 	return -1;
 }
+
+/* No ctrl-iface: bSTA event source unavailable. */
+int wpactrl_register_event(const char *ifname, struct event_struct *req, void **handle)
+{
+	(void) ifname; (void) req; (void) handle;
+	return -1;
+}
+
+int wpactrl_recv_event(const char *ifname, void *handle)
+{
+	(void) ifname; (void) handle;
+	return -ENETDOWN;
+}
+
+int wpactrl_unregister_event(const char *ifname, void *handle)
+{
+	(void) ifname; (void) handle;
+	return -1;
+}
 #endif
 
