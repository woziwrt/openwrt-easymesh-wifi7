+/* Event dispatchers: pick the source by req->family so a single driver can
+ * carry both the nl80211 netlink event socket and the Phase-2 wpactrl bSTA
+ * connection-state source. Both set req->fd_monitor; wifimngr adds it to uloop.
+ *
+ * The concrete per-source handles are opaque and their layouts differ (the
+ * nlwifi handle does not lead with its event_struct), so we hand wifimngr a
+ * small tagged wrapper and unwrap it in recv/unregister. */
+enum wifi_evsrc {
+	EVSRC_NL80211,
+	EVSRC_WPACTRL,
+};
+
+struct wifi_evhandle {
+	enum wifi_evsrc src;
+	void *inner;
+};
+
+static int wifi_dispatch_register_event(const char *ifname,
+					struct event_struct *req, void **handle)
+{
+	struct wifi_evhandle *h;
+	int ret;
+
+	h = calloc(1, sizeof(*h));
+	if (!h)
+		return -1;
+
+	if (!strncmp(req->family, "wpactrl", sizeof(req->family))) {
+		h->src = EVSRC_WPACTRL;
+		ret = wpactrl_register_event(ifname, req, &h->inner);
+	} else {
+		h->src = EVSRC_NL80211;
+		ret = nlwifi_register_event(ifname, req, &h->inner);
+	}
+
+	if (ret) {
+		free(h);
+		return ret;
+	}
+
+	*handle = h;
+	return 0;
+}
+
+static int wifi_dispatch_recv_event(const char *ifname, void *handle)
+{
+	struct wifi_evhandle *h = handle;
+
+	if (!h)
+		return -ENETDOWN;
+
+	if (h->src == EVSRC_WPACTRL)
+		return wpactrl_recv_event(ifname, h->inner);
+	return nlwifi_recv_event(ifname, h->inner);
+}
+
+static int wifi_dispatch_unregister_event(const char *ifname, void *handle)
+{
+	struct wifi_evhandle *h = handle;
+	int ret;
+
+	if (!h)
+		return -1;
+
+	if (h->src == EVSRC_WPACTRL)
+		ret = wpactrl_unregister_event(ifname, h->inner);
+	else
+		ret = nlwifi_unregister_event(ifname, h->inner);
+
+	free(h);
+	return ret;
+}
+
 
 const struct wifi_driver default_wifi_driver = {
 	.name = "wlan,phy,bsta",
@@ -2201,7 +2275,7 @@
 	.iface.mld_get_ifstatus = get_ifstatus,
 
