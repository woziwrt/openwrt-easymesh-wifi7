+/*
+ * staconn_cache.h - process-local, event-driven bSTA connection-state cache.
+ *
+ * Phase 2 (ADR-0009): status reads hit this cache instead of a blocking
+ * wpa_ctrl/hostapd_ctrl round-trip. One entry per STA (backhaul) interface,
+ * keyed by ifname. Populated event-driven (wpactrl ATTACH + nl80211/mlme
+ * CONNECT/DISCONNECT); read take-copy-under-lock so the internal monitor
+ * thread (Engine A) is safe against the single-threaded uloop reader (Engine B).
+ *
+ * Copyright (C) 2026 Petr Wozniak (WOZIWRT project) / IOPSYS Software Solutions AB.
+ */
+#ifndef STACONN_CACHE_H
+#define STACONN_CACHE_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <time.h>
+
+#include <easy/easy.h>	/* struct ip_address, ifopstatus_t prereqs */
+#include "wifiutils.h"	/* enum wifi_band, SSID_MAX_LEN */
+
+/* Suggested TTL for the read path (self-heals a dropped event). */
+#define STACONN_TTL_MS		5000
+
+/* One backhaul-STA connection record. Copied out to callers; never aliased. */
+struct bsta_conn {
+	char ifname[16];		/* key */
+	bool valid;			/* entry has been populated at least once */
+	bool connected;			/* wpa_state == COMPLETED */
+
+	uint8_t bssid[6];		/* associated AP bssid (kept on disconnect) */
+	uint8_t ssid[SSID_MAX_LEN + 1];	/* ssid + NUL */
+	uint8_t ssidlen;
+
+	uint32_t freq;			/* operating frequency in MHz */
+	uint8_t channel;		/* control channel */
+	enum wifi_band band;		/* derived from freq */
+	bool is4addr;			/* 4addr (WDS) backhaul */
+
+	uint16_t last_reason;		/* last DISCONNECT/ASSOC-REJECT reason */
+
+	struct timespec ts;		/* CLOCK_MONOTONIC of last update */
+};
+
+/* Copy the entry for @ifname into @out. Returns 0 on hit (valid entry copied),
+ * -1 on miss. Reader computes freshness with staconn_cache_age_ms(out). */
+int staconn_cache_get(const char *ifname, struct bsta_conn *out);
+
+/* Upsert keyed by e->ifname: replaces the record, sets valid=true and stamps
+ * ts=now(MONOTONIC). Use for a full write-through of an authoritative STATUS.
+ * For partial mutations use staconn_cache_apply() (atomic RMW) instead. */
+void staconn_cache_update(const struct bsta_conn *e);
+
+/* Atomic read-modify-write keyed by @ifname. Takes the mutex ONCE, finds or
+ * creates the entry (ifname pre-filled), runs @cb to mutate it, then stamps ts
+ * and sets valid before releasing. This is what makes the Engine-A (internal
+ * pthread) safety claim real: partial updates (bssid-only, connected-only)
+ * never lose a concurrent writer's fields to a get()/update() race. */
+void staconn_cache_apply(const char *ifname,
+			 void (*cb)(struct bsta_conn *e, void *ctx), void *ctx);
+
+/* Mark the entry stale (supplicant restart / ctrl-socket death). Keeps the
+ * record so last-known bssid survives; forces the read path to fall through. */
+void staconn_cache_invalidate(const char *ifname);
+
+/* Age of a copied-out entry in milliseconds (monotonic). Lock-free: operates
+ * on the caller's copy, not the shared table. */
+long staconn_cache_age_ms(const struct bsta_conn *e);
+
+#endif /* STACONN_CACHE_H */
--- /dev/null
+++ b/libwifi/modules/wpactrl/staconn_cache.c
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: LGPL-2.1-only */
+/*
+ * staconn_cache.c - process-local bSTA connection-state cache (see .h).
+ *
+ * Deliberately tiny: a fixed table of a few STA interfaces, one mutex, four
+ * entry points. No dynamic allocation, no ubus/uloop coupling -- only the
+ * cache is touched, so it is safe to call from Engine A (internal monitor
+ * pthread) and Engine B (uloop) alike.
+ *
+ * Copyright (C) 2026 Petr Wozniak (WOZIWRT project) / IOPSYS Software Solutions AB.
+ */
+#include <string.h>
+#include <pthread.h>
+
+#include "staconn_cache.h"
+
+/* A board carries a handful of backhaul STA vifs at most. */
+#define STACONN_MAX	8
+
+static pthread_mutex_t staconn_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct bsta_conn staconn_tbl[STACONN_MAX];
+
+static void staconn_now(struct timespec *ts)
+{
+	clock_gettime(CLOCK_MONOTONIC, ts);
+}
+
+/* Caller must hold staconn_lock. Returns slot for @ifname, or NULL if absent. */
+static struct bsta_conn *staconn_find(const char *ifname)
+{
+	int i;
+
+	for (i = 0; i < STACONN_MAX; i++) {
+		if (staconn_tbl[i].valid &&
+		    !strncmp(staconn_tbl[i].ifname, ifname, sizeof(staconn_tbl[i].ifname)))
+			return &staconn_tbl[i];
+	}
+	return NULL;
+}
+
+/* Caller must hold staconn_lock. Returns slot for @ifname, allocating a free
+ * one if needed, or NULL when the table is full. */
+static struct bsta_conn *staconn_get_slot(const char *ifname)
+{
+	struct bsta_conn *e;
+	int i;
+
+	e = staconn_find(ifname);
+	if (e)
+		return e;
+
+	for (i = 0; i < STACONN_MAX; i++) {
+		if (!staconn_tbl[i].valid)
+			return &staconn_tbl[i];
+	}
+	return NULL;
+}
+
+int staconn_cache_get(const char *ifname, struct bsta_conn *out)
+{
+	struct bsta_conn *e;
+	int ret = -1;
+
+	if (!ifname || !out)
+		return -1;
+
+	pthread_mutex_lock(&staconn_lock);
+	e = staconn_find(ifname);
+	if (e) {
+		*out = *e;		/* take-copy-under-lock */
+		ret = 0;
+	}
+	pthread_mutex_unlock(&staconn_lock);
+
+	return ret;
+}
+
+void staconn_cache_update(const struct bsta_conn *e)
+{
+	struct bsta_conn *slot;
+
+	if (!e || !e->ifname[0])
+		return;
+
+	pthread_mutex_lock(&staconn_lock);
+	slot = staconn_get_slot(e->ifname);
+	if (slot) {
+		*slot = *e;
+		slot->valid = true;
+		staconn_now(&slot->ts);
+	}
+	pthread_mutex_unlock(&staconn_lock);
+}
+
+void staconn_cache_apply(const char *ifname,
+			 void (*cb)(struct bsta_conn *e, void *ctx), void *ctx)
+{
+	struct bsta_conn *slot;
+
+	if (!ifname || !cb)
+		return;
+
+	pthread_mutex_lock(&staconn_lock);
+	slot = staconn_get_slot(ifname);
+	if (slot) {
+		/* pre-fill the key so a freshly-claimed slot is addressable */
+		strncpy(slot->ifname, ifname, sizeof(slot->ifname) - 1);
+		cb(slot, ctx);
+		slot->valid = true;
+		staconn_now(&slot->ts);
+	}
+	pthread_mutex_unlock(&staconn_lock);
+}
+
+void staconn_cache_invalidate(const char *ifname)
+{
+	struct bsta_conn *e;
+
+	if (!ifname)
+		return;
+
+	pthread_mutex_lock(&staconn_lock);
+	e = staconn_find(ifname);
+	if (e) {
+		/* keep the record (last bssid), just force the read path to
+		 * treat it as stale until the next event/STATUS repopulates. */
+		e->valid = false;
+	}
+	pthread_mutex_unlock(&staconn_lock);
+}
+
+long staconn_cache_age_ms(const struct bsta_conn *e)
+{
+	struct timespec now;
+
+	if (!e)
+		return -1;
+
+	staconn_now(&now);
+	return (now.tv_sec - e->ts.tv_sec) * 1000L +
+	       (now.tv_nsec - e->ts.tv_nsec) / 1000000L;
+}
