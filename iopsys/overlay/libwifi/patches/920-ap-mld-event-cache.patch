+/* ---- Layer 1: apconn_cache write-through helpers. The AP-status / assoclist
+ * reads below are cache-first (zero blocking I/O when fresh) and write through
+ * their bounded-hostapd result so the next read is hot. See apconn_cache.{c,h}
+ * and the reliability design notes (warm cache = layer 1 of 3). ----------- */
+struct apconn_ap_ctx {
+	bool enabled;
+	uint8_t channel;
+	enum wifi_band band;
+	uint8_t bw;
+};
+
+static void apconn_cb_set_ap(struct apconn *e, void *ctx)
+{
+	struct apconn_ap_ctx *c = ctx;
+
+	e->enabled = c->enabled;
+	if (c->channel)
+		e->channel = c->channel;
+	if (c->band)
+		e->band = c->band;
+	if (c->bw)
+		e->bandwidth = c->bw;
+}
+
+struct apconn_stas_ctx {
+	const uint8_t *stas;
+	int nsta;
+};
+
+/* Replace the cached station SET authoritatively (bounded hostapd reconcile). */
+static void apconn_cb_set_stas(struct apconn *e, void *ctx)
+{
+	struct apconn_stas_ctx *c = ctx;
+	int n = c->nsta < APCONN_STA_MAX ? c->nsta : APCONN_STA_MAX;
+	int i;
+
+	for (i = 0; i < n; i++)
+		memcpy(e->stations[i], &c->stas[i * 6], 6);
+	e->nsta = n;
+	e->enabled = true;
+}
+
+static void apconn_writethrough_stas(const char *ifname, const uint8_t *stas, int nsta)
+{
+	struct apconn_stas_ctx c = { .stas = stas, .nsta = nsta };
+
+	apconn_cache_apply(ifname, apconn_cb_set_stas, &c);
+}
+
