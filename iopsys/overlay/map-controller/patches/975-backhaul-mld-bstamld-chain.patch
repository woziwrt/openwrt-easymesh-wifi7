 	struct list_head apmld_list;       /** list of struct wifi_apmld_element */
 	struct ieee1905_security_caps sec; /** 1905 security caps (step 2) */
 	bool sec_valid;                    /** @sec populated (step 2) */
+	/* DB Phase 1.5 (MLD, bSTA) - APPEND ONLY. A node has exactly one
+	 * backhaul uplink -> single element (NULL until a 0xE1 TLV is parsed),
+	 * not a list. Mirror of apmld_list's lifecycle. */
