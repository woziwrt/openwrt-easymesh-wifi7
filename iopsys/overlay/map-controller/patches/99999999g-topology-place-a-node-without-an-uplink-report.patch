--- a/src/topology.c
+++ b/src/topology.c
@@ -23,6 +23,7 @@
 #include "cntlr_events.h"
 #include "db/mapc_sync.h"
 #include "cntlr.h"
+#include "sta.h"
 
 
 void init_topology(struct bh_topology_data *topology)
@@ -75,19 +76,273 @@ static struct node *find_node_with_mld_macaddr(struct controller *c,
 	return NULL;
 }
 
+const char *bh_source_str(uint8_t source)
+{
+	switch (source) {
+	case BH_SRC_CHILD:		return "child";
+	case BH_SRC_PARENT_ASSOC:	return "parent-assoc";
+	case BH_SRC_NEIGHBOR:		return "neighbor";
+	case BH_SRC_NEIGHBOR_MUTUAL:	return "neighbor-mutual";
+	default:			return "none";
+	}
+}
+
+static void bh_reset(struct bh_topology_dev *dev)
+{
+	dev->bh.depth = UNKNOWN_TREE_LEVEL;
+	dev->bh.wifi_hops_from_root = 0;
+	dev->bh.parent = NULL;
+	dev->bh.parent_iface = NULL;
+	dev->bh.own_iface = NULL;
+	dev->bh.source = BH_SRC_NONE;
+	dev->bh.media_type = 0xFFFF;
+}
+
+static void place_dev(struct bh_topology_dev *dev,
+		      const struct bh_topology_dev *pdev,
+		      const uint8_t *parent_iface_mac, uint16_t media_type,
+		      uint8_t source)
+{
+	bool wifi = (media_type & 0xff00) == 0x0100;
+
+	dev->bh.parent = pdev;
+	dev->bh.depth = pdev->bh.depth + 1;
+	/* An uplink of unknown media counts as wired: we only claim a
+	 * Wi-Fi hop when something told us it is one.
+	 */
+	dev->bh.wifi_hops_from_root = pdev->bh.wifi_hops_from_root + (wifi ? 1 : 0);
+	dev->bh.source = source;
+	dev->bh.media_type = media_type;
+
+	/* Hand mapc_sync_topology the parent interface as a local_iface,
+	 * so it emits parent_iface_mac.
+	 *
+	 * The copy lives in the child. It used to be appended to the
+	 * parent's ifaces[]: that raised the parent's interface count above
+	 * what its Device Information TLV says, so the next Topology
+	 * Response from the parent counted as a change and rewrote ifaces[]
+	 * under the child's pointer, and a parent with a full ifaces[] gave
+	 * its children no parent_iface at all.
+	 */
+	memset(&dev->parent_iface_store, 0, sizeof(dev->parent_iface_store));
+	if (parent_iface_mac) {
+		memcpy(dev->parent_iface_store.macaddr, parent_iface_mac, 6);
+		dev->parent_iface_store.media_type = media_type;
+		dev->bh.parent_iface = &dev->parent_iface_store;
+	}
+}
+
+/* Source 1: the node the child itself says it is attached to. */
+static struct node *claimed_parent(struct controller *c, struct node *cn)
+{
+	static const uint8_t zmac[6] = {0};
+	struct node *pn;
+
+	if (!memcmp(cn->upstream_bssid, zmac, 6))
+		return NULL;
+
+	pn = cntlr_find_node_with_bssid(c, cn->upstream_bssid);
+	if (!pn)
+		pn = find_node_with_mld_macaddr(c, cn->upstream_bssid);
+
+	return pn;
+}
+
+static bool sta_is_backhaul_of(const struct sta *s, const struct node *xn)
+{
+	if (s->state == STA_DISCONNECTED)
+		return false;
+
+	/* Backhaul STA Capability Report: the agent named this bSTA its own. */
+	if (s->is_bsta && !memcmp(s->bsta_agent_almacaddr, xn->almacaddr, 6))
+		return true;
+
+	/* An MLO bSTA is listed by its MLD address, while the capability
+	 * report above names the links. The child's Backhaul STA MLD
+	 * Config ties both to it.
+	 */
+	if (xn->bstamld) {
+		struct wifi_affiliated_sta_element *a = NULL;
+
+		if (!memcmp(s->macaddr, xn->bstamld->mld_macaddr, 6))
+			return true;
+		list_for_each_entry(a, &xn->bstamld->affbstalist, list) {
+			if (!memcmp(s->macaddr, a->macaddr, 6))
+				return true;
+		}
+	}
+
+	return false;
+}
+
+/* Source 2: a node that reports the child's backhaul STA among its
+ * associated clients. That is the parent confirming the link from its own
+ * side, and it is all we get from an agent that answers neither Link
+ * Metric Query nor sends Backhaul STA MLD Config (a MediaTek R3 agent).
+ */
+static struct node *assoc_parent(struct controller *c, struct node *xn,
+				 struct sta **bsta)
+{
+	struct node *yn = NULL;
+
+	list_for_each_entry(yn, &c->agentlist, list) {
+		struct sta *s = NULL;
+
+		if (yn == xn)
+			continue;
+		list_for_each_entry(s, &yn->stalist, list) {
+			if (sta_is_backhaul_of(s, xn)) {
+				*bsta = s;
+				return yn;
+			}
+		}
+	}
+
+	return NULL;
+}
+
+/* Index of the interface on which @dev lists @al as a 1905 neighbour. */
+static int iface_listing(const struct bh_topology_dev *dev, const uint8_t *al)
+{
+	int i, k;
+
+	for (i = 0; i < dev->number_of_interfaces && i < IFACE_MAX_NUM; i++) {
+		const struct local_iface *li = &dev->ifaces[i];
+
+		for (k = 0; k < li->number_of_neighbors && k < NEIGHBORS_MAX_NUM; k++) {
+			if (hwaddr_equal(li->neighbors_al_macs[k], al))
+				return i;
+		}
+	}
+
+	return -1;
+}
+
+/* Source 3: 1905 neighbours, either direction.
+ *
+ * A 1905 neighbour is not a physical neighbour. Topology Discovery goes to
+ * 01:80:c2:00:00:13, which a Linux bridge forwards, so a node hears every
+ * node its uplink bridges to. Seen on hardware 2026-09-18: the MediaTek box
+ * wired to x8's LAN, and our corridor agent, associated to x8 over Wi-Fi,
+ * listing it as a neighbour on its bSTA - next to x8, its real parent.
+ *
+ * Two rules keep such a leak from being taken for the uplink:
+ * - Y is not X's parent when Y hears X on the same interface Y hears its
+ *   own parent on: X is then upstream of Y, not below it;
+ * - of the candidates left, the deepest one wins. A leak reaches X through
+ *   the bridge of every node between, so the real parent is the nearest,
+ *   and the nearest is the deepest.
+ *
+ * A candidate that has no place yet may be the real parent: *pending says
+ * so, and the caller waits for it unless nothing else moves.
+ */
+static struct bh_topology_dev *neighbor_parent(struct bh_topology_data *topology,
+					       struct bh_topology_dev *dev,
+					       int *x_if, int *y_if,
+					       bool *pending)
+{
+	struct bh_topology_dev *y = NULL, *best = NULL;
+
+	*pending = false;
+	list_for_each_entry(y, &topology->dev_list, list) {
+		int xi, yi;
+
+		if (y == dev || y->bh.parent == dev)
+			continue;
+
+		xi = iface_listing(dev, y->al_macaddr);
+		yi = iface_listing(y, dev->al_macaddr);
+		if (xi < 0 && yi < 0)
+			continue;
+
+		if (y->bh.depth == UNKNOWN_TREE_LEVEL) {
+			*pending = true;
+			continue;
+		}
+
+		if (y->bh.parent && yi >= 0 &&
+		    yi == iface_listing(y, y->bh.parent->al_macaddr))
+			continue;	/* X is on Y's uplink side */
+
+		if (!best || y->bh.depth > best->bh.depth) {
+			best = y;
+			*x_if = xi;
+			*y_if = yi;
+		}
+	}
+
+	return best;
+}
+
+/* Place one device from sources 1 and 2. Returns true if it was placed. */
+static bool place_from_reports(struct controller *c,
+			       struct bh_topology_data *topology,
+			       struct bh_topology_dev *dev, struct node *cn,
+			       bool *has_evidence)
+{
+	struct bh_topology_dev *pdev;
+	struct sta *bsta = NULL;
+	struct node *pn;
+
+	pn = claimed_parent(c, cn);
+	if (pn) {
+		*has_evidence = true;
+		pdev = topology_find_device(topology, pn->almacaddr);
+		if (!pdev || pdev == dev || pdev->bh.depth == UNKNOWN_TREE_LEVEL)
+			return false;	/* parent not placed yet */
+
+		place_dev(dev, pdev, cn->upstream_bssid, 0x0100, BH_SRC_CHILD);
+		return true;
+	}
+
+	pn = assoc_parent(c, cn, &bsta);
+	if (pn) {
+		*has_evidence = true;
+		pdev = topology_find_device(topology, pn->almacaddr);
+		if (!pdev || pdev == dev || pdev->bh.depth == UNKNOWN_TREE_LEVEL)
+			return false;
+
+		place_dev(dev, pdev, bsta->bssid, 0x0100, BH_SRC_PARENT_ASSOC);
+		return true;
+	}
+
+	*has_evidence = false;
+	return false;
+}
+
 void topology_build_tree_from_assoc(struct controller *c,
 				    struct bh_topology_data *topology,
 				    const uint8_t *ctrl_al_macaddr)
 {
-	static const uint8_t zmac[6] = {0};
-	struct bh_topology_dev *root, *dev;
+	struct bh_topology_dev *root, *dev, *tmp;
 	struct node *n;
-	bool progress;
 	time_t now;
 
-	topology_remove_all_devices(topology);
+	/* Keep the devices, and with them what their Topology Responses told
