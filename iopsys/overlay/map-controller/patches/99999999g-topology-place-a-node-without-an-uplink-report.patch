-			if (!pn)
-				pn = find_node_with_mld_macaddr(c, cn->upstream_bssid);
-			if (!pn)
-				continue;
-			pdev = topology_find_device(topology, pn->almacaddr);
-			if (!pdev || pdev->bh.depth == UNKNOWN_TREE_LEVEL)
-				continue;	/* parent not placed yet */
-
-			dev->bh.parent = pdev;
-			dev->bh.depth = pdev->bh.depth + 1;
-			dev->bh.wifi_hops_from_root =
-				pdev->bh.wifi_hops_from_root + 1;
-
-			/* Hand mapc_sync_topology the parent bBSS as a local_iface,
-			 * so it emits parent_iface_mac == upstream_bssid.
-			 *
-			 * The copy lives in the child. It used to be appended to
-			 * the parent's ifaces[]: that raised the parent's interface
-			 * count above what its Device Information TLV says, so the
-			 * next Topology Response from the parent counted as a
-			 * change and rewrote ifaces[] under the child's pointer,
-			 * and a parent with a full ifaces[] gave its children no
-			 * parent_iface at all.
-			 */
