+		bh_reset(dev);
+
+	list_for_each_entry_safe(dev, tmp, &topology->dev_list, list) {
+		if (!memcmp(dev->al_macaddr, ctrl_al_macaddr, 6) ||
+		    cntlr_find_node(c, dev->al_macaddr))
+			continue;
 
-	root = topology_add_device(topology, ctrl_al_macaddr);
+		list_del(&dev->list);
+		free(dev);
+		topology->num_devs--;
+	}
+
+	root = topology_find_device(topology, ctrl_al_macaddr);
+	if (!root)
+		root = topology_add_device(topology, ctrl_al_macaddr);
 	if (!root)
 		return;
 	root->bh.depth = 0;
@@ -101,51 +356,91 @@ void topology_build_tree_from_assoc(struct controller *c,
 			topology_add_device(topology, n->almacaddr);
 	}
 
-	/* place each dev under its upstream parent; repeat until stable (N-hop) */
-	do {
-		progress = false;
-		list_for_each_entry(dev, &topology->dev_list, list) {
-			struct bh_topology_dev *pdev;
-			struct node *cn, *pn;
-
-			if (dev->bh.depth != UNKNOWN_TREE_LEVEL)
-				continue;
-			cn = cntlr_find_node(c, dev->al_macaddr);
-			if (!cn || !memcmp(cn->upstream_bssid, zmac, 6))
