+/* ---- sta (associated client) ------------------------------------------ */
+
+void mapc_sync_sta(struct controller *c, struct node *n, struct sta *s)
+{
+	static const char *sql =
+		"INSERT INTO sta(macaddr, bssid, associated, is_bsta, agent_almac, "
+		"last_ul_rate, last_dl_rate, est_mac_rate_ul, est_mac_rate_dl, "
+		"conn_time, rcpi, util_tx, util_rx, pkts_tx, pkts_rx, bytes_tx, "
+		"bytes_rx, errors_tx, errors_rx, retrans_count, hostname) "
+		"VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) "
+		"ON CONFLICT(macaddr) DO UPDATE SET "
+		"bssid=excluded.bssid, associated=excluded.associated, "
+		"is_bsta=excluded.is_bsta, agent_almac=excluded.agent_almac, "
+		"last_ul_rate=excluded.last_ul_rate, last_dl_rate=excluded.last_dl_rate, "
+		"est_mac_rate_ul=excluded.est_mac_rate_ul, "
+		"est_mac_rate_dl=excluded.est_mac_rate_dl, conn_time=excluded.conn_time, "
+		"rcpi=excluded.rcpi, util_tx=excluded.util_tx, util_rx=excluded.util_rx, "
+		"pkts_tx=excluded.pkts_tx, pkts_rx=excluded.pkts_rx, "
+		"bytes_tx=excluded.bytes_tx, bytes_rx=excluded.bytes_rx, "
+		"errors_tx=excluded.errors_tx, errors_rx=excluded.errors_rx, "
+		"retrans_count=excluded.retrans_count, hostname=excluded.hostname";
+	struct wifi_sta_element *d = s->de_sta;
+	char mac[18], bssid[18], almac[18];
+	mapdb_stmt *st = NULL;
+
+	if (!c->db)
+		return;
+
+	mac2str(s->macaddr, mac);
+	mac2str(s->bssid, bssid);
+	mac2str(n->almacaddr, almac);
+
+	if (mapdb_prepare(c->db, sql, &st) != MAPDB_OK) {
+		warn("mapc_sync: sta prepare: %s\n", mapdb_last_error(c->db));
+		return;
+	}
+	mapdb_bind_text(st, 1, mac);
+	mapdb_bind_text(st, 2, bssid);
+	mapdb_bind_int(st, 3, s->state != STA_DISCONNECTED);
+	mapdb_bind_int(st, 4, s->is_bsta);
+	mapdb_bind_text(st, 5, almac);
+	if (d) {
+		mapdb_bind_int(st, 6, d->ul_rate);
+		mapdb_bind_int(st, 7, d->dl_rate);
+		mapdb_bind_int(st, 8, d->ul_est_thput);
+		mapdb_bind_int(st, 9, d->dl_est_thput);
+		mapdb_bind_int(st, 10, d->conn_time);
+		mapdb_bind_int(st, 11, d->rcpi);
+		mapdb_bind_int(st, 12, (long long)d->dl_utilization);
+		mapdb_bind_int(st, 13, (long long)d->ul_utilization);
+		mapdb_bind_int(st, 14, d->tx_pkts);
+		mapdb_bind_int(st, 15, d->rx_pkts);
+		mapdb_bind_int(st, 16, (long long)d->tx_bytes);
+		mapdb_bind_int(st, 17, (long long)d->rx_bytes);
+		mapdb_bind_int(st, 18, d->tx_errors);
+		mapdb_bind_int(st, 19, d->rx_errors);
+		mapdb_bind_int(st, 20, d->rtx_pkts);
+		mapdb_bind_text(st, 21, d->hostname[0] ? d->hostname : NULL);
+	} else {
+		int i;
+		for (i = 6; i <= 21; i++)
+			mapdb_bind_null(st, i);
+	}
+	stmt_finish(c->db, st);
+}
+
+void mapc_del_sta(struct controller *c, struct sta *s)
+{
+	static const char *sql = "DELETE FROM sta WHERE macaddr=?";
+	char mac[18];
+	mapdb_stmt *st = NULL;
+
+	if (!c->db)
+		return;
+
+	mac2str(s->macaddr, mac);
+
+	if (mapdb_prepare(c->db, sql, &st) != MAPDB_OK) {
+		warn("mapc_sync: sta delete prepare: %s\n", mapdb_last_error(c->db));
+		return;
+	}
+	mapdb_bind_text(st, 1, mac);
+	stmt_finish(c->db, st);
+}
+
 /* ---- topology_link ---------------------------------------------------- */
 
