diff -ruN a/src/db/mapdb_sqlite.c b/src/db/mapdb_sqlite.c
--- /dev/null
+++ b/src/db/mapdb_sqlite.c
@@ -0,0 +1,322 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * mapdb_sqlite.c - SQLite backend for the map-controller persistence layer.
+ *
+ * Phase 0 (ADR-0003): the only file that touches libsqlite3. It implements the
+ * mapdb.h primitives and sets a crash-safe embedded posture on open (WAL +
+ * busy_timeout + foreign_keys + synchronous=NORMAL). No mesh/app logic - just
+ * the storage engine. A MariaDB backend would be a sibling mapdb_mariadb.c
+ * implementing the same header; nothing else changes (design doc s4).
+ *
+ * Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>	/* strcasecmp */
+#include <stdio.h>
+#include <errno.h>
+#include <sys/stat.h>	/* mkdir */
+
+#include <sqlite3.h>
+
+#include "db/mapdb.h"
+#include "utils/debug.h"
+
+/* Block up to this long on a locked DB before returning SQLITE_BUSY. WAL means
+ * a single writer at a time; the controller is single-writer anyway. */
+#define MAPDB_BUSY_TIMEOUT_MS	5000
+
+struct mapdb {
+	sqlite3 *h;
+	char errmsg[256];
+};
+
+struct mapdb_stmt {
+	sqlite3_stmt *st;
+	mapdb *db;		/* back-ptr for error propagation */
+};
+
+/* Copy sqlite's current error string into the handle's buffer. */
+static void mapdb_set_error(mapdb *db, const char *ctx)
+{
+	const char *msg = db->h ? sqlite3_errmsg(db->h) : "no db handle";
+
+	snprintf(db->errmsg, sizeof(db->errmsg), "%s: %s",
+		 ctx ? ctx : "mapdb", msg ? msg : "unknown");
+}
+
+const char *mapdb_last_error(mapdb *db)
+{
+	if (!db)
+		return "mapdb: NULL handle";
+	return db->errmsg[0] ? db->errmsg : "no error";
+}
+
+/* Best-effort create of the immediate parent directory of @path (single level,
+ * e.g. /etc/mapc for /etc/mapc/mapc.db). sqlite3_open_v2 will not mkdir. */
+static void mapdb_mkdir_parent(const char *path)
+{
+	char dir[256];
+	char *slash;
+
+	snprintf(dir, sizeof(dir), "%s", path);
+	slash = strrchr(dir, '/');
+	if (!slash || slash == dir)	/* no dir component, or root ("/x") */
+		return;
+	*slash = '\0';
+
+	if (mkdir(dir, 0755) != 0 && errno != EEXIST)
+		warn("mapdb: mkdir %s: %s\n", dir, strerror(errno));
+}
+
+/* Engage WAL and confirm it actually took: PRAGMA journal_mode returns the mode
+ * now in effect, and sqlite silently falls back to the rollback journal when the
+ * fs/dir can't host the -wal/-shm files (matters on f2fs/overlay). Don't fail the
+ * open on fallback - rollback-journal is still crash-safe - just surface it. */
+static void mapdb_set_wal(mapdb *db)
+{
+	mapdb_stmt *st = NULL;
+	const char *mode;
+
+	if (mapdb_prepare(db, "PRAGMA journal_mode = WAL;", &st) != MAPDB_OK) {
+		warn("mapdb: could not set journal_mode: %s\n", mapdb_last_error(db));
+		return;
+	}
+	if (mapdb_step(st) == MAPDB_ROW) {
+		mode = mapdb_column_text(st, 0);
+		if (!mode || strcasecmp(mode, "wal") != 0)
+			warn("mapdb: WAL not engaged (journal_mode=%s); "
+			     "using rollback journal\n", mode ? mode : "?");
+		else
+			info("mapdb: journal_mode=wal\n");
+	}
+	mapdb_finalize(st);
+}
+
+/* ---- lifecycle -------------------------------------------------------- */
+
+mapdb *mapdb_open(const char *path)
+{
+	mapdb *db;
+	int rc;
+
+	if (!path)
+		path = mapdb_default_path();
+
+	db = calloc(1, sizeof(*db));
+	if (!db) {
+		err("mapdb: calloc failed\n");
+		return NULL;
+	}
+
+	mapdb_mkdir_parent(path);
+
+	rc = sqlite3_open_v2(path, &db->h,
+			     SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE, NULL);
+	if (rc != SQLITE_OK) {
+		mapdb_set_error(db, "open");
+		err("mapdb: cannot open %s: %s\n", path, mapdb_last_error(db));
+		/* sqlite3_open_v2 allocates a handle even on error; free it. */
+		sqlite3_close_v2(db->h);
+		free(db);
+		return NULL;
+	}
+
+	sqlite3_busy_timeout(db->h, MAPDB_BUSY_TIMEOUT_MS);
+
+	/* Crash-safe embedded posture. WAL: readers never block the writer and an
+	 * interrupted write rolls back cleanly (verified, not assumed - see
+	 * mapdb_set_wal). synchronous=NORMAL is the WAL sweet spot (durable across
+	 * app crash / OS crash; only a power loss mid-fsync can lose the very last
+	 * txn - acceptable for a warm-cache graph). */
+	mapdb_set_wal(db);
+	if (mapdb_exec(db, "PRAGMA synchronous = NORMAL;") != MAPDB_OK ||
+	    mapdb_exec(db, "PRAGMA foreign_keys = ON;") != MAPDB_OK) {
+		err("mapdb: pragma setup failed: %s\n", mapdb_last_error(db));
+		mapdb_close(db);
+		return NULL;
+	}
+
+	if (mapdb_apply_schema(db) != MAPDB_OK) {
+		err("mapdb: schema apply failed: %s\n", mapdb_last_error(db));
+		mapdb_close(db);
+		return NULL;
+	}
+
+	info("mapdb: opened %s (WAL, schema applied)\n", path);
+	return db;
+}
+
+void mapdb_close(mapdb *db)
+{
+	if (!db)
+		return;
+	/* close_v2 (not close): defers teardown until any still-open statements are
+	 * finalized and ALWAYS frees the handle, so an unfinalized stmt can never
+	 * leak the connection (close() would return SQLITE_BUSY and keep it alive). */
+	sqlite3_close_v2(db->h);
+	free(db);
+}
+
+/* ---- one-shot exec ---------------------------------------------------- */
+
+int mapdb_exec(mapdb *db, const char *sql)
+{
+	char *emsg = NULL;
+	int rc;
+
+	if (!db || !db->h)
+		return MAPDB_ERR;
+
+	rc = sqlite3_exec(db->h, sql, NULL, NULL, &emsg);
+	if (rc != SQLITE_OK) {
+		snprintf(db->errmsg, sizeof(db->errmsg), "exec: %s",
+			 emsg ? emsg : sqlite3_errmsg(db->h));
+		sqlite3_free(emsg);
+		return MAPDB_ERR;
+	}
+	return MAPDB_OK;
+}
+
+/* ---- prepared statements ---------------------------------------------- */
+
+int mapdb_prepare(mapdb *db, const char *sql, mapdb_stmt **stmt)
+{
+	mapdb_stmt *s;
+	int rc;
+
+	if (!db || !db->h || !stmt)
+		return MAPDB_ERR;
+
+	s = calloc(1, sizeof(*s));
+	if (!s) {
+		mapdb_set_error(db, "prepare/calloc");
+		return MAPDB_ERR;
+	}
+	s->db = db;
+
+	rc = sqlite3_prepare_v2(db->h, sql, -1, &s->st, NULL);
+	if (rc != SQLITE_OK) {
+		mapdb_set_error(db, "prepare");
+		free(s);
+		return MAPDB_ERR;
+	}
+
+	*stmt = s;
+	return MAPDB_OK;
+}
+
+int mapdb_bind_text(mapdb_stmt *stmt, int idx, const char *val)
+{
+	int rc;
+
+	if (!stmt)
+		return MAPDB_ERR;
+
+	/* NULL value -> SQL NULL. SQLITE_TRANSIENT: sqlite copies the string, so
+	 * the caller's buffer need not outlive the bind. */
+	rc = val ? sqlite3_bind_text(stmt->st, idx, val, -1, SQLITE_TRANSIENT)
+		 : sqlite3_bind_null(stmt->st, idx);
+	if (rc != SQLITE_OK) {
+		mapdb_set_error(stmt->db, "bind_text");
+		return MAPDB_ERR;
+	}
+	return MAPDB_OK;
+}
+
+int mapdb_bind_int(mapdb_stmt *stmt, int idx, long long val)
+{
+	if (!stmt)
+		return MAPDB_ERR;
+
+	if (sqlite3_bind_int64(stmt->st, idx, (sqlite3_int64)val) != SQLITE_OK) {
+		mapdb_set_error(stmt->db, "bind_int");
+		return MAPDB_ERR;
+	}
+	return MAPDB_OK;
+}
+
+int mapdb_bind_null(mapdb_stmt *stmt, int idx)
+{
+	if (!stmt)
+		return MAPDB_ERR;
+
+	if (sqlite3_bind_null(stmt->st, idx) != SQLITE_OK) {
+		mapdb_set_error(stmt->db, "bind_null");
+		return MAPDB_ERR;
+	}
+	return MAPDB_OK;
+}
+
+int mapdb_step(mapdb_stmt *stmt)
+{
+	int rc;
+
+	if (!stmt)
+		return MAPDB_ERR;
+
+	rc = sqlite3_step(stmt->st);
+	switch (rc) {
+	case SQLITE_ROW:
+		return MAPDB_ROW;
+	case SQLITE_DONE:
+		return MAPDB_DONE;
+	default:
+		mapdb_set_error(stmt->db, "step");
+		return MAPDB_ERR;
+	}
+}
+
+const char *mapdb_column_text(mapdb_stmt *stmt, int col)
+{
+	if (!stmt)
+		return NULL;
+	/* Valid until the next step/reset/finalize; caller copies if it needs to
+	 * keep it (Phase 1 marshalling does). */
+	return (const char *)sqlite3_column_text(stmt->st, col);
+}
+
+long long mapdb_column_int(mapdb_stmt *stmt, int col)
+{
+	if (!stmt)
+		return 0;
+	return (long long)sqlite3_column_int64(stmt->st, col);
+}
+
+int mapdb_reset(mapdb_stmt *stmt)
+{
+	if (!stmt)
+		return MAPDB_ERR;
+	/* Clears bindings too, so a re-used statement starts from a clean slate. */
+	sqlite3_clear_bindings(stmt->st);
+	if (sqlite3_reset(stmt->st) != SQLITE_OK) {
+		mapdb_set_error(stmt->db, "reset");
+		return MAPDB_ERR;
+	}
+	return MAPDB_OK;
+}
+
+void mapdb_finalize(mapdb_stmt *stmt)
+{
+	if (!stmt)
+		return;
+	sqlite3_finalize(stmt->st);
+	free(stmt);
+}
+
+/* ---- transactions ----------------------------------------------------- */
+
+int mapdb_begin(mapdb *db)
+{
+	return mapdb_exec(db, "BEGIN;");
+}
+
+int mapdb_commit(mapdb *db)
+{
+	return mapdb_exec(db, "COMMIT;");
+}
+
+int mapdb_rollback(mapdb *db)
+{
+	return mapdb_exec(db, "ROLLBACK;");
+}
diff -ruN a/src/db/mapdb.c b/src/db/mapdb.c
--- /dev/null
+++ b/src/db/mapdb.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * mapdb.c - engine-neutral persistence helpers for map-controller.
+ *
+ * Phase 0 (ADR-0003): the parts of the storage layer that do NOT depend on the
+ * backend - the default DB path and the schema bootstrap. Everything here is
+ * built purely on the mapdb.h primitives (mapdb_exec / mapdb_prepare / ...), so
+ * a future mapdb_mariadb.c reuses this file unchanged. The engine-specific code
+ * lives only in mapdb_sqlite.c.
+ *
+ * No mesh/app logic yet - Phase 1 adds the marshalling + write/restore hooks.
+ *
+ * Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
+ */
+#include <time.h>
+
+#include "db/mapdb.h"
+#include "db/mapdb_schema.h"
+
+#ifndef MAPDB_DEFAULT_PATH
+/* Dedicated subdir on the writable overlay (survives reboot -> powercycle
+ * recovery works), kept in its own subdir so Phase 1 can exclude /etc/mapc/
+ * from the sysupgrade backup: a firmware flash then starts with a fresh DB rather
+ * than carrying a stale graph + schema_version across images (design doc s7 Q7).
+ * mapdb_open() creates the parent dir. Overridable at build time with
+ * -DMAPDB_DEFAULT_PATH=\"...\" or at runtime via mapdb_open(path). */
+#define MAPDB_DEFAULT_PATH "/etc/mapc/mapc.db"
+#endif
+
+const char *mapdb_default_path(void)
+{
+	return MAPDB_DEFAULT_PATH;
+}
+
+/* Seed the single schema_version row on a fresh DB. Idempotent: a no-op once a
+ * row exists (migrations, when we have them, will UPDATE it instead). */
+static int mapdb_seed_version(mapdb *db)
+{
+	mapdb_stmt *st = NULL;
+	int rc;
+
+	if (mapdb_prepare(db, "SELECT version FROM schema_version LIMIT 1", &st) != MAPDB_OK)
+		return MAPDB_ERR;
+
+	rc = mapdb_step(st);
+	mapdb_finalize(st);
+
+	if (rc == MAPDB_ROW)
+		return MAPDB_OK;	/* already seeded */
+	if (rc != MAPDB_DONE)
+		return MAPDB_ERR;
+
+	if (mapdb_prepare(db,
+			  "INSERT INTO schema_version(version, applied_at) VALUES(?, ?)",
+			  &st) != MAPDB_OK)
+		return MAPDB_ERR;
+
+	mapdb_bind_int(st, 1, MAPDB_SCHEMA_VERSION);
+	mapdb_bind_int(st, 2, (long long)time(NULL));
+
+	rc = mapdb_step(st);
+	mapdb_finalize(st);
+
+	return (rc == MAPDB_DONE) ? MAPDB_OK : MAPDB_ERR;
+}
+
+int mapdb_apply_schema(mapdb *db)
+{
+	if (!db)
+		return MAPDB_ERR;
+
+	if (mapdb_begin(db) != MAPDB_OK)
+		return MAPDB_ERR;
+
+	/* One multi-statement exec; every table is CREATE TABLE IF NOT EXISTS. */
+	if (mapdb_exec(db, MAPDB_SCHEMA_SQL) != MAPDB_OK)
+		goto fail;
+
+	if (mapdb_seed_version(db) != MAPDB_OK)
+		goto fail;
+
+	if (mapdb_commit(db) != MAPDB_OK)
+		goto fail;			/* roll back; don't leave the txn open */
+
+	return MAPDB_OK;
+
+fail:
+	mapdb_rollback(db);
+	return MAPDB_ERR;
+}
diff -ruN a/src/db/mapdb.h b/src/db/mapdb.h
--- /dev/null
+++ b/src/db/mapdb.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * mapdb.h - engine-agnostic persistence interface for map-controller.
+ *
+ * Phase 0 (ADR-0003): the thin storage seam that the rest of the controller
+ * will call. It knows nothing about mesh state - only rows and transactions.
+ * Two backends implement it: mapdb_sqlite.c (eMMC baseline, default) and, later,
+ * mapdb_mariadb.c (NVMe). Nothing here leaks a backend type, so swapping the
+ * engine is a one-file change (design doc s4).
+ *
+ * Design-doc note: s4 sketches this as "db_client.h" with a callback-style
+ * db_query(); we ship it as mapdb.* with an explicit prepare/step statement API
+ * so binds replace string-concatenated SQL (no SSID injection/escaping bugs).
+ *
+ * Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
+ */
+#ifndef MAPDB_H
+#define MAPDB_H
+
+/* Opaque handles - callers never see sqlite3* / MYSQL*. */
+typedef struct mapdb mapdb;
+typedef struct mapdb_stmt mapdb_stmt;
+
+/* Return / status codes. */
+#define MAPDB_OK	 0	/* success */
+#define MAPDB_ERR	-1	/* failure; see mapdb_last_error() */
+#define MAPDB_ROW	 1	/* mapdb_step(): a row is available */
+#define MAPDB_DONE	 2	/* mapdb_step(): statement finished, no more rows */
+
+/* ---- lifecycle -------------------------------------------------------- */
+
+/* Open (creating if absent) the DB at @path, configure the engine for a
+ * crash-safe embedded posture (WAL, busy_timeout, foreign_keys) and apply the
+ * schema (mapdb_apply_schema()). @path == NULL uses mapdb_default_path().
+ * Returns a handle, or NULL on failure. */
+mapdb *mapdb_open(const char *path);
+
+/* Flush and close. Safe on NULL. */
+void mapdb_close(mapdb *db);
+
+/* Compile-time default DB file location (see MAPDB_DEFAULT_PATH). */
+const char *mapdb_default_path(void);
+
+/* Create every table (CREATE TABLE IF NOT EXISTS ...) from the embedded DDL and
+ * seed the schema_version row on a fresh DB. Idempotent; engine-neutral (built
+ * only on the primitives below), so every backend reuses it. Wrapped in one
+ * transaction. Returns MAPDB_OK / MAPDB_ERR. Called by mapdb_open(). */
+int mapdb_apply_schema(mapdb *db);
+
+/* ---- one-shot statements ---------------------------------------------- */
+
+/* Execute a statement that returns no rows (DDL / INSERT / UPDATE / PRAGMA).
+ * Multiple ';'-separated statements are allowed. Returns MAPDB_OK / MAPDB_ERR. */
+int mapdb_exec(mapdb *db, const char *sql);
+
+/* ---- prepared statements (bind params are 1-based, columns 0-based) --- */
+
+int mapdb_prepare(mapdb *db, const char *sql, mapdb_stmt **stmt);
+int mapdb_bind_text(mapdb_stmt *stmt, int idx, const char *val);	/* NULL -> SQL NULL */
+int mapdb_bind_int(mapdb_stmt *stmt, int idx, long long val);
+int mapdb_bind_null(mapdb_stmt *stmt, int idx);
+
+/* Advance one step: MAPDB_ROW (row ready, read columns), MAPDB_DONE (finished)
+ * or MAPDB_ERR. */
+int mapdb_step(mapdb_stmt *stmt);
+
+/* Column accessors valid only after mapdb_step() == MAPDB_ROW. The returned
+ * text points into engine memory and is valid until the next step/finalize. */
+const char *mapdb_column_text(mapdb_stmt *stmt, int col);
+long long   mapdb_column_int(mapdb_stmt *stmt, int col);
+
+/* Rewind a prepared statement so its binds can be re-set and re-stepped. */
+int mapdb_reset(mapdb_stmt *stmt);
+
+/* Release a prepared statement. Safe on NULL. */
+void mapdb_finalize(mapdb_stmt *stmt);
+
+/* ---- transactions ----------------------------------------------------- */
+
+int mapdb_begin(mapdb *db);
+int mapdb_commit(mapdb *db);
+int mapdb_rollback(mapdb *db);
+
+/* ---- diagnostics ------------------------------------------------------ */
+
+/* Human-readable text for the last failure on @db. Never NULL. */
+const char *mapdb_last_error(mapdb *db);
+
+#endif /* MAPDB_H */
