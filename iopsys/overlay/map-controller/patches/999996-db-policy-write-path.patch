From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] mapc_sync: stamp rows on every upsert and sample the signal history
Signed-off-by: Petr Wozniak <petr.wozniak@gmail.com>

Every sta upsert now writes last_seen (first_seen only on insert, so the
first sighting survives), the affiliated_sta writer stamps its rows, and
both writers feed sta_metrics_hist through mapc_hist_sample(): a sample
is stored only when rcpi moved by >= 4 or the last sample is >= 60 s old,
values 0/255 (not measured) never - so the table grows by a handful of
rows per client per minute at worst, batched inside the transactions the
writers already hold. The sampler lives next to the writers on purpose:
history can never disagree with the row it summarizes.

--- a/src/db/mapc_sync.c
+++ b/src/db/mapc_sync.c
@@ -487,14 +487,72 @@
 
 /* ---- sta (associated client) ------------------------------------------ */
 
+#define MAPC_HIST_MIN_INTERVAL	60	/* seconds between forced samples */
+#define MAPC_HIST_RCPI_DELTA	4	/* immediate sample on this much change */
+
+/* DB policy pack: append a signal sample for (macaddr,bssid) when it moved
+ * enough or enough time passed. 0/255 mean "not measured" and are never
+ * sampled. Called from the same writers that persist the live value, so the
+ * history can never disagree with the row it summarizes. The hourly ageout
+ * keeps the table at its cap. */
+void mapc_hist_sample(struct controller *c, const char *macaddr,
+		      const char *bssid, int rcpi, int dl_rate, int ul_rate)
+{
+	static const char *last_sql =
+		"SELECT ts, rcpi FROM sta_metrics_hist "
+		"WHERE macaddr=? AND bssid=? ORDER BY ts DESC LIMIT 1";
+	static const char *ins_sql =
+		"INSERT INTO sta_metrics_hist"
+		"(macaddr, bssid, rcpi, dl_rate, ul_rate, ts) "
+		"VALUES(?,?,?,?,?,?)";
+	long long now = (long long)time(NULL);
+	long long last_ts = 0;
+	int last_rcpi = 0, delta;
+	mapdb_stmt *st = NULL;
+	int rc;
+
+	if (!c->db || !rcpi || rcpi == 255)
+		return;
+
+	if (mapdb_prepare(c->db, last_sql, &st) != MAPDB_OK)
+		return;
+	mapdb_bind_text(st, 1, macaddr);
+	mapdb_bind_text(st, 2, bssid);
+	rc = mapdb_step(st);
+	if (rc == MAPDB_ROW) {
+		last_ts = mapdb_column_int(st, 0);
+		last_rcpi = mapdb_column_int(st, 1);
+	}
+	mapdb_finalize(st);
+
+	delta = rcpi - last_rcpi;
+	if (delta < 0)
+		delta = -delta;
+	if (rc == MAPDB_ROW && now - last_ts < MAPC_HIST_MIN_INTERVAL &&
+	    delta < MAPC_HIST_RCPI_DELTA)
+		return;
+
+	st = NULL;
+	if (mapdb_prepare(c->db, ins_sql, &st) != MAPDB_OK)
+		return;
+	mapdb_bind_text(st, 1, macaddr);
+	mapdb_bind_text(st, 2, bssid);
+	mapdb_bind_int(st, 3, rcpi);
+	mapdb_bind_int(st, 4, dl_rate);
+	mapdb_bind_int(st, 5, ul_rate);
+	mapdb_bind_int(st, 6, now);
+	stmt_finish(c->db, st);
+}
+
 void mapc_sync_sta(struct controller *c, struct node *n, struct sta *s)
 {
