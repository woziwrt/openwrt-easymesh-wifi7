+		mapc_hist_sample(c, mac, bssid, d->rcpi, d->ul_rate, d->dl_rate);
+
 	/* 999992: one MAC cannot be associated to two nodes at once, so the
 	 * moment a node reports this client, every row for it under a DIFFERENT
 	 * node is stale by definition.
@@ -876,8 +943,8 @@
 	 * is the "never measured" RCPI) must not overwrite a real reading. */
 	static const char *ins_affsta =
 		"INSERT INTO affiliated_sta(macaddr, mld_macaddr, bssid, "
-		"rcpi, dl_rate, ul_rate, bytes_tx, bytes_rx) "
-		"VALUES(?,?,?,?,?,?,?,?) "
+		"rcpi, dl_rate, ul_rate, bytes_tx, bytes_rx, last_seen) "
+		"VALUES(?,?,?,?,?,?,?,?,?) "
 		"ON CONFLICT(macaddr, bssid) DO UPDATE SET "
 		"mld_macaddr=excluded.mld_macaddr, "
 		"rcpi=CASE WHEN excluded.rcpi NOT IN (0,255) "
@@ -889,7 +956,7 @@
 		"bytes_tx=CASE WHEN excluded.bytes_tx>0 "
 			"THEN excluded.bytes_tx ELSE affiliated_sta.bytes_tx END, "
 		"bytes_rx=CASE WHEN excluded.bytes_rx>0 "
-			"THEN excluded.bytes_rx ELSE affiliated_sta.bytes_rx END";
+			"THEN excluded.bytes_rx ELSE affiliated_sta.bytes_rx END, last_seen=excluded.last_seen";
 	static const char *del_affsta =
 		"DELETE FROM affiliated_sta WHERE mld_macaddr=?";
 	static const char *ins_ttlm =
@@ -1067,10 +1134,18 @@
 					mapdb_bind_int(st, 6, (long long)as->ul_rate);
 					mapdb_bind_int(st, 7, (long long)as->tx_bytes);
 					mapdb_bind_int(st, 8, (long long)as->rx_bytes);
+					mapdb_bind_int(st, 9, (long long)time(NULL));
 					if (stmt_finish(c->db, st) != MAPDB_OK) {
 						mapdb_rollback(c->db);
