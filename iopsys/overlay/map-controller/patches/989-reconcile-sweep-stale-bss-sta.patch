 				list_for_each_entry(bss, &r->iflist, list)
--- a/src/db/mapc_sync.c
+++ b/src/db/mapc_sync.c
@@ -569,6 +569,46 @@
 	stmt_finish(c->db, st);
 }
 
+/* Delete sta rows for node @n that are NOT in its live stalist -- the re-flash
+ * bSTA ghosts that never emit a disassoc event. Conservative: an empty (or
+ * absurdly wide) report deletes nothing, so a half-parsed CMDU cannot wipe the
+ * table. Keyed on agent_almac so only this node's rows are touched. */
+void mapc_sync_sta_sweep(struct controller *c, struct node *n)
+{
+	char almac[18], sql[128 + 3 * 32];
+	mapdb_stmt *st = NULL;
+	struct sta *s;
+	int cnt = 0, i;
+
+	if (!c->db)
+		return;
+
+	list_for_each_entry(s, &n->stalist, list)
+		cnt++;
+	if (cnt == 0 || cnt > 32)
+		return;
+
+	mac2str(n->almacaddr, almac);
+	snprintf(sql, sizeof(sql),
+		 "DELETE FROM sta WHERE agent_almac=? AND macaddr NOT IN (");
+	for (i = 0; i < cnt; i++)
+		strcat(sql, i ? ",?" : "?");
+	strcat(sql, ")");
+
+	if (mapdb_prepare(c->db, sql, &st) != MAPDB_OK) {
+		warn("mapc_sync: sta sweep prepare: %s\n", mapdb_last_error(c->db));
+		return;
+	}
+	mapdb_bind_text(st, 1, almac);
+	i = 2;
+	list_for_each_entry(s, &n->stalist, list) {
+		char m[18];
+		mac2str(s->macaddr, m);
+		mapdb_bind_text(st, i++, m);
+	}
+	stmt_finish(c->db, st);
+}
