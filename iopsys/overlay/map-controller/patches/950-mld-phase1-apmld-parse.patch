+++ b/src/cntlr.c	2026-07-13 17:37:45.319075944 +0200
@@ -1029,6 +1029,10 @@
 
 	INIT_LIST_HEAD(&n->stalist);
 	INIT_LIST_HEAD(&n->radiolist);
+#if (EASYMESH_VERSION >= 6)
+	INIT_LIST_HEAD(&n->apmld_list);
+	n->num_apmld = 0;
+#endif
 	n->sta_count = 0;
 	list_add(&n->list, &c->devlist);
 	c->num_devs++;
@@ -1584,6 +1588,31 @@
 	timer_set(&c->signal_handler, 1 * 1000);
 }
 
+#if (EASYMESH_VERSION >= 6)
+/* Free the AP-MLD model attached to a node: each apmld plus its affiliated-AP
+ * and TID-to-Link child lists (DB Phase 1.5). Safe to call on an empty list. */
+void cntlr_free_apmld_list(struct node *n)
+{
+	struct wifi_apmld_element *mld = NULL, *mtmp;
+	struct wifi_affiliated_ap_element *ap = NULL, *atmp;
+	struct wifi_ttlm_element *tt = NULL, *ttmp;
+
+	list_for_each_entry_safe(mld, mtmp, &n->apmld_list, list) {
+		list_for_each_entry_safe(ap, atmp, &mld->aplist, list) {
+			list_del(&ap->list);
+			free(ap);
+		}
+		list_for_each_entry_safe(tt, ttmp, &mld->ttlmlist, list) {
+			list_del(&tt->list);
+			free(tt);
+		}
+		list_del(&mld->list);
+		free(mld);
+	}
+	n->num_apmld = 0;
+}
+#endif
+
 static bool cntlr_clean_node(struct controller *c, struct node *n)
 {
 	struct netif_radio *r = NULL, *temp;
@@ -1600,6 +1629,9 @@
 	node_clean_stalist(c, n);
 	cntlr_clean_radiolist(c, n);
 	mactable_del_entry(c->mac_table, n->almacaddr, MAC_ENTRY_ALID);
+#if (EASYMESH_VERSION >= 6)
+	cntlr_free_apmld_list(n);
+#endif
 
 	info("%s: Node " MACFMT " removed due to ageout\n",
 	     __func__, MAC2STR(n->almacaddr));
