-				"\"backhaulmac\":\"" MACFMT "\", "
-				"\"backhaulalid\":\"" MACFMT "\"}", MAC2STR(dev->al_macaddr),
-				MAC2STR(downstream_mac), MAC2STR(upstream_mac), MAC2STR(upstream_al));
-		if (first_event)
