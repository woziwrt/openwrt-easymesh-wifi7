-		const uint8_t *upstream_mac = NULL;
-		const uint8_t *upstream_al = NULL;
-		bool topology_changed = false;
-		bool first_event = false;
-		static const uint8_t zero_mac[6] = {0};
-		char ev_data[512] = {0};
-
-		if (memcmp(dev->al_macaddr, ctrl_al_macaddr, 6) == 0)
