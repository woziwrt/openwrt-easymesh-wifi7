-
-		downstream_mac = (dev->bh.own_iface) ? dev->bh.own_iface->macaddr : dev->al_macaddr;
-		upstream_mac = (dev->bh.parent_iface) ? dev->bh.parent_iface->macaddr : ctrl_al_macaddr;
-		upstream_al = (dev->bh.parent) ? dev->bh.parent->al_macaddr : ctrl_al_macaddr;
-
-		if (!memcmp(dev->prev_parent_aladdr, zero_mac, 6) &&
-				!memcmp(dev->prev_iface_mac, zero_mac, 6)) {
-			first_event = true;
-		}
-
-		if (memcmp(dev->prev_parent_aladdr, upstream_al, 6) != 0 ||
-				memcmp(dev->prev_iface_mac, downstream_mac, 6) != 0) {
-			topology_changed = true;
-		}
-
-		if (!topology_changed)
-			continue;
-
-		memcpy(dev->prev_parent_aladdr, upstream_al, 6);
-		memcpy(dev->prev_iface_mac, downstream_mac, 6);
-
-		snprintf(ev_data, sizeof(ev_data), "{ \"agent\": \"" MACFMT "\", "
