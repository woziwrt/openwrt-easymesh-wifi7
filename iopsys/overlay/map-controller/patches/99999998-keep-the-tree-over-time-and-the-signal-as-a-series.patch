From: Petr Wozniak <petr.wozniak@gmail.com>
Subject: [PATCH] map-controller: keep the tree over time, and the signal as a series

Two tables the model has been missing, and the writers for them. Neither
changes any decision - they only record what is already known but thrown
away.

topology_link holds the backhaul tree as it is now and is rebuilt wholesale
on every sync, so a re-parent leaves no trace at all. The mesh re-parents far
more often than one expects: three different trees in one morning on
2026-09-06, with no box moved, and again twice on 2026-09-07. "What did the
tree look like at 03:00" has had no answer.

topology_link_history stores one row per existence of an edge rather than one
per measurement, so the state at an instant is a single WHERE from_ts <= X
AND (to_ts IS NULL OR to_ts > X). At ten re-parents a day that is about 200
rows in 20 days. The edges are directed, child -> parent, because the cost of
A->B is not the cost of B->A - different power and different noise at each
end - which is what makes this usable later for a shortest-path tree and not
only for a picture. Today the neighbor table cannot hold that: its PRIMARY
KEY is one row per node, so it can carry a tree but never a graph.

metric_hist keeps hourly min/avg/max per subject, kind and MLO leg. A month
of ten-second samples is unreadable and expensive; min/avg/max per hour
answers "is this link getting worse", which is the question actually asked.
Twenty series over 20 days is under 10 000 rows. leg is NOT NULL because
NULLs compare distinct in a PRIMARY KEY and the upsert depends on the
conflict firing. An MLD and its legs must never share a series: an MLD
reports signal 0 dBm while its leg runs 1297 Mbit/s, so a mixed series shows
an outage that never happened.

Both are written from the topology sync. The history is two idempotent
statements in the transaction that just rebuilt the edge set - close every
open row whose edge is gone, open a row for every edge that has none - so a
sync that changed nothing writes nothing, and the history can never disagree
with the tree it came from. The series is folded once a minute rather than
once per sync, because the database is on flash and a running mean does not
need every sample.

rcpi 0 and 255 are both "unknown" and are excluded from the fold rather than
averaged in. A series that folds an unmeasured value is the same defect as a
column that cannot tell measured from unmeasured - which is what four
separate bugs closed on 2026-09-07 turned out to be.

No optimiser and no actuator: this only starts the record, so that when a
shortest-path tree is worth building there is history to build it on instead
of an empty table.

Verify: re-parent a node and `select * from topology_link_history order by
from_ts desc limit 4` must show the old edge closed and the new one open at
the same second; after an hour, metric_hist must hold one row per bSTA with
samples > 1 and min <= avg <= max.

Signed-off-by: Petr Wozniak <petr.wozniak@gmail.com>
---
--- a/src/db/mapdb_schema.h
+++ b/src/db/mapdb_schema.h
@@ -16,7 +16,7 @@
 #define MAPDB_SCHEMA_H
 
 /* Bump when the DDL below changes; drives the schema_version migration gate. */
-#define MAPDB_SCHEMA_VERSION 3
+#define MAPDB_SCHEMA_VERSION 4
 
 /* schema.sql, verbatim. CREATE TABLE IF NOT EXISTS throughout -> idempotent. */
 static const char MAPDB_SCHEMA_SQL[] =
@@ -425,6 +425,58 @@
 	"    ts      INTEGER NOT NULL               -- epoch seconds\n"
 	");\n"
 	"CREATE INDEX IF NOT EXISTS idx_hist_mac_ts ON sta_metrics_hist(macaddr, ts);\n"
+	/* The backhaul tree over time, as intervals rather than samples.
+	 *
+	 * topology_link holds the tree as it is now and is rebuilt wholesale on
+	 * every sync, so a re-parent leaves no trace. The mesh re-parents far
+	 * more often than one expects - three different trees in one morning on
+	 * 2026-09-06, with no box moved - and "what did the tree look like at
+	 * 03:00" has had no answer at all.
+	 *
+	 * One row per existence of an edge, not per measurement: the state at
+	 * an instant is a single WHERE from_ts <= X AND (to_ts IS NULL OR
+	 * to_ts > X). At ten re-parents a day that is ~200 rows in 20 days.
+	 *
+	 * The edges are directed (child -> parent) because the cost of A->B is
+	 * not the cost of B->A - different power and different noise at each
+	 * end. That is what makes this usable later for a shortest-path tree
+	 * and not only for a picture. */
+	"CREATE TABLE IF NOT EXISTS topology_link_history (\n"
+	"    child_almac          TEXT NOT NULL,\n"
+	"    parent_almac         TEXT NOT NULL,\n"
+	"    iface_mac            TEXT,\n"
+	"    media_type           INTEGER,\n"
+	"    from_ts              INTEGER NOT NULL,   -- epoch, edge appeared\n"
+	"    to_ts                INTEGER             -- NULL = still up\n"
+	");\n"
+	"CREATE INDEX IF NOT EXISTS idx_tlh_open ON topology_link_history(child_almac, to_ts);\n"
+	"CREATE INDEX IF NOT EXISTS idx_tlh_window ON topology_link_history(from_ts, to_ts);\n"
+	/* Hourly min/avg/max series, one row per subject+kind+leg+hour.
+	 *
+	 * Deliberately not a table of samples: a month of ten-second readings
+	 * is unreadable and expensive, while min/avg/max per hour answers "is
+	 * this link getting worse", which is the question actually asked.
+	 * 20 series x 24 h x 20 days is under 10 000 rows.
+	 *
+	 * leg is the MLO link id, -1 when the value is not per-leg. NOT NULL
+	 * because NULLs compare distinct in a PRIMARY KEY and the upsert below
+	 * depends on the conflict firing.
+	 *
+	 * An MLD and its legs must never share a series: an MLD reports
+	 * signal 0 dBm while its leg runs 1297 Mbit/s, so a series that mixes
+	 * them shows an outage that never happened. */
+	"CREATE TABLE IF NOT EXISTS metric_hist (\n"
+	"    subject              TEXT NOT NULL,      -- almac / bssid / ruid\n"
+	"    kind                 TEXT NOT NULL,      -- 'bh_rcpi', 'anpi', ...\n"
+	"    leg                  INTEGER NOT NULL DEFAULT -1,\n"
+	"    ts_hour              INTEGER NOT NULL,   -- epoch truncated to hour\n"
+	"    min_val              REAL,\n"
+	"    avg_val              REAL,\n"
+	"    max_val              REAL,\n"
+	"    samples              INTEGER NOT NULL DEFAULT 0,\n"
+	"    PRIMARY KEY (subject, kind, leg, ts_hour)\n"
+	");\n"
+	"CREATE INDEX IF NOT EXISTS idx_metric_hour ON metric_hist(kind, ts_hour);\n"
 	"-- policy reads views, not raw tables (phase-5 contract)\n"
 	"DROP VIEW IF EXISTS sta_trend;\n"
 	"CREATE VIEW sta_trend AS\n"
--- a/src/db/mapc_sync.c
+++ b/src/db/mapc_sync.c
@@ -883,6 +883,79 @@
 		}
 	}
 
+	/* Turn the edge set into intervals, inside the same transaction that
+	 * rebuilt it - so the history can never disagree with the tree it was
+	 * derived from.
+	 *
+	 * Two statements and no bookkeeping in C: close every open row whose
+	 * edge is no longer present, then open a row for every edge that has
+	 * none. Both are idempotent, so a sync that changed nothing writes
+	 * nothing. */
+	{
+		static const char *close_sql =
+			"UPDATE topology_link_history SET to_ts=? "
+			"WHERE to_ts IS NULL AND NOT EXISTS ("
+			"  SELECT 1 FROM topology_link t"
+			"   WHERE t.child_almac = topology_link_history.child_almac"
+			"     AND t.parent_almac = topology_link_history.parent_almac)";
+		static const char *open_sql =
+			"INSERT INTO topology_link_history"
+			"(child_almac, parent_almac, iface_mac, media_type, from_ts) "
+			"SELECT t.child_almac, t.parent_almac, t.iface_mac,"
+			"       t.media_type, ? FROM topology_link t "
+			" WHERE NOT EXISTS ("
+			"  SELECT 1 FROM topology_link_history h"
+			"   WHERE h.child_almac = t.child_almac"
+			"     AND h.parent_almac = t.parent_almac"
+			"     AND h.to_ts IS NULL)";
+		long long now_ts = (long long)time(NULL);
+
+		st = NULL;
+		if (mapdb_prepare(c->db, close_sql, &st) == MAPDB_OK) {
+			mapdb_bind_int(st, 1, now_ts);
+			stmt_finish(c->db, st);
+		}
+		st = NULL;
+		if (mapdb_prepare(c->db, open_sql, &st) == MAPDB_OK) {
+			mapdb_bind_int(st, 1, now_ts);
+			stmt_finish(c->db, st);
+		}
+	}
+
+	/* Fold the backhaul signal into the hourly series.
+	 *
+	 * Once a minute, not once per sync: the database lives on flash, and a
+	 * running mean does not need every sample to be useful.
+	 *
+	 * rcpi 0 and 255 are both "unknown" and are excluded rather than
+	 * averaged - a series that folds an unmeasured value in is the same
+	 * defect as a column that cannot tell measured from unmeasured. */
+	{
+		static const char *fold_sql =
+			"INSERT INTO metric_hist"
+			"(subject, kind, leg, ts_hour, min_val, avg_val, max_val, samples) "
+			"SELECT macaddr, 'bh_rcpi', -1, (?/3600)*3600, rcpi, rcpi, rcpi, 1"
+			"  FROM sta WHERE COALESCE(is_bsta,0)=1"
+			"   AND rcpi IS NOT NULL AND rcpi BETWEEN 1 AND 254 "
+			"ON CONFLICT(subject, kind, leg, ts_hour) DO UPDATE SET "
+			"  min_val = MIN(metric_hist.min_val, excluded.min_val),"
+			"  max_val = MAX(metric_hist.max_val, excluded.max_val),"
+			"  avg_val = (metric_hist.avg_val * metric_hist.samples"
+			"             + excluded.avg_val) / (metric_hist.samples + 1),"
+			"  samples = metric_hist.samples + 1";
+		static time_t last_fold;
+		time_t now = time(NULL);
+
+		if (now - last_fold >= 60) {
+			last_fold = now;
+			st = NULL;
+			if (mapdb_prepare(c->db, fold_sql, &st) == MAPDB_OK) {
+				mapdb_bind_int(st, 1, (long long)now);
+				stmt_finish(c->db, st);
+			}
+		}
+	}
+
 	if (mapdb_commit(c->db) != MAPDB_OK) {
 		warn("mapc_sync: topology commit: %s\n", mapdb_last_error(c->db));
 		mapdb_rollback(c->db);
