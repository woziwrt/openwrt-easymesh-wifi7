+					 * carried associated=0 in the database while it was
+					 * carrying traffic.
+					 */
+					if (memcmp(s->bssid, bssid, 6)) {
+						memcpy(s->bssid, bssid, 6);
+						memcpy(s->de_sta->bssid, bssid, 6);
+					}
+					s->state = STA_CONNECTED;
 					s->de_sta->conn_time = conntime;
 				}
 
