config controller 'controller'
	option enabled '1'	# may be modified by other package start-up scripts (i.e. map-agent)
	option profile '3'
	option registrar '2 5 6'
	option debug '2'
	option bcn_metrics_max_num '10'
	option enable_ts '0'
	option primary_vid '1'
	option primary_pcp '0'
	option stale_sta_timeout '20d'
	option de_collect_interval '60'
	option de_hide_dm_scanres '1'
	list plugin 'zerotouch'

config sta_steering 'sta_steering'
	option enable_sta_steer '1'
	option enable_bsta_steer '1'
	option rcpi_threshold_2g '70'
	option rcpi_threshold_5g '86'
	option rcpi_threshold_6g '86'
	option report_rcpi_threshold_2g '80'
	option report_rcpi_threshold_5g '96'
	option report_rcpi_threshold_6g '96'
	option plugins_enabled '1'
	option plugins_policy 'any'
	list plugins 'rcpi'
	list plugins 'rate'
	list plugins 'bsteer'

config channel_plan 'channel_plan'
	option preclear_dfs '0'
	option acs '1'

###################
# Default AP sections credentials will by updated
# by uci-defaults script 99-mapcntlr
###################

config ap 'ap_fh_2g'
	option band '2'
	option ssid '$WIFI_FH_2G_SSID'
	option encryption '$WIFI_FH_2G_ENCRYPTION'
	option key '$WIFI_FH_2G_KEY'
	option vid '1'
	option type 'fronthaul'
	option network_type 'Primary'
#	option mld_id '1'

config ap 'ap_fh_5g'
	option band '5'
	option ssid '$WIFI_FH_5G_SSID'
	option encryption '$WIFI_FH_5G_ENCRYPTION'
	option key '$WIFI_FH_5G_KEY'
	option vid '1'
	option type 'fronthaul'
	option network_type 'Primary'
#	option mld_id '1'

config ap 'ap_fh_6g'
	option band '6'
	option ssid '$WIFI_FH_6G_SSID'
	option encryption '$WIFI_FH_6G_ENCRYPTION'
	option key '$WIFI_FH_6G_KEY'
	option vid '1'
	option network_type 'Primary'
	option type 'fronthaul'
#	option mld_id '1'

config ap 'ap_bh_2g'
	option band '2'
	option ssid 'MAP-$BASEMAC_ADDR-BH'
	option encryption 'sae'
	option key '$WIFI_BH_KEY'
	option type 'backhaul'
	option network_type 'Backhaul'
	option vid '1'
	option hidden '1'
#	option mld_id '2'

config ap 'ap_bh_5g'
	option band '5'
	option ssid 'MAP-$BASEMAC_ADDR-BH'
	option encryption 'sae'
	option key '$WIFI_BH_KEY'
	option type 'backhaul'
	option network_type 'Backhaul'
	option vid '1'
	option hidden '1'
#	option mld_id '2'

config ap 'ap_bh_6g'
	option band '6'
	option ssid 'MAP-$BASEMAC_ADDR-BH'
	option encryption 'sae'
	option key '$WIFI_BH_KEY'
	option type 'backhaul'
	option network_type 'Backhaul'
	option vid '1'
	# NOT hidden, unlike the 2.4/5 GHz backhaul above. OpenWrt sets
	# mbssid=1 on 6 GHz, and hostapd rejects an entire phy that carries a
	# hidden BSS inside an MBSSID set:
	#   hostapd: 1 errors found in configuration file '<inline>'
	#   hostapd: hostapd.add_iface failed for phy phy0.2 ifname=ap-mld-1
	# The AP-MLD then comes up with 2 links instead of 3 and nothing in
	# the logs points at this line. Measured on bpi-x8, 2026-07-21.
	option hidden '0'
#	option mld_id '2'

