# Gets off a parent that no longer takes our frames, on agents. See
# /usr/sbin/easymesh-uplink-guard.

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /etc/mapc/role 2>/dev/null)" = "controller" ] && return 0
	procd_open_instance
	procd_set_param command /usr/sbin/easymesh-uplink-guard
	procd_set_param respawn
	procd_close_instance
}
