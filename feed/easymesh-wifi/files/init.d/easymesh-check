# START=99 and a settle delay: every rule this checks is about the state a
# node ends up in, not the state it passes through. Asking too early only
# produces noise about things that are still being built.

START=99
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/easymesh-check ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh -c 'sleep 120; exec /usr/sbin/easymesh-check'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
