# Runs before mapagent (S97) so that, on a node whose configuration was wiped,
# mapagent starts with the AP-MLD section it needs instead of being restarted
# afterwards. See /usr/sbin/mld-config-check for what this recovers.
#
# Deliberately synchronous, unlike mld-link-check: the whole point is to finish
# before the next init script runs. It is a no-op on a healthy boot, so it
# costs nothing there.

START=96

boot() {
	/usr/sbin/mld-config-check >/dev/null 2>&1
}

stop() {
	return 0
}

# start() is deliberately not where the work lives. rcS calls every S* script
# with "boot"; base-files default_postinst calls "start" on every init script a
# package ships, on install and on upgrade alike. This one only ever means to
# act while the node is coming up, and the ten-minute boot window it also
# checks is a guess from uptime that guesses wrong exactly when it matters -
# installing a few minutes after a flash lands inside it. Asking the init
# system what it is doing beats inferring it from a clock.
start() {
	echo "mld-config-check: boot only - it runs itself on the next restart" >&2
}
