#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# Report a hostapd or wpa_supplicant that stopped answering ubus. See
# /usr/sbin/hostapd-watch for what it cost to not have this.
#
# START=99: it only observes, nothing at boot depends on it, and its first
# probe is a full INTERVAL after start - by which time the radios have had
# their say.

START=99
USE_PROCD=1

# The gate lives in a file this package ships. If it is ever not there, say so
# out loud: a service that silently stops starting is the failure this whole
# layer exists to avoid. Note the [ -r ] - sourcing a missing file ends the
# script outright in ash, so `if ! . file` would never reach its else branch.
if [ -r /usr/share/easymesh/boot-window.sh ]; then
	. /usr/share/easymesh/boot-window.sh
else
	logger -t hostapd-watch "cannot read /usr/share/easymesh/boot-window.sh - refusing to start"
	is_mesh_node() { return 1; }
fi

start_service() {
	# A router nobody has onboarded has an ordinary hostapd doing ordinary work,
	# and no mesh that depends on it answering. Watching it here only means this
	# package has an opinion about a box that never asked for one. Same reason,
	# and same placement, as bh-key-adopt above.
	is_mesh_node || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/hostapd-watch
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
