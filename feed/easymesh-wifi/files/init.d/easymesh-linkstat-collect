# Gather per-leg liveness from the agents. Controller only - the worker exits
# at once anywhere else, so this may be enabled on every image.
#
# START=99: it asks other boxes over HTTP and none of them exist at boot.

START=99
USE_PROCD=1

start_service() {
	# The worker does the controller test itself (mapcontroller.enabled).
	# Keeping the gate there rather than here is deliberate: a box that
	# BECOMES the controller must not need this file edited.
	procd_open_instance
	procd_set_param command /usr/sbin/easymesh-linkstat-collect 30
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
