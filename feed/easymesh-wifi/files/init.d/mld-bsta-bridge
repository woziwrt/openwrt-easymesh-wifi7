#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# Keep the backhaul MLD STA attached to its bridge. See
# /usr/sbin/mld-bsta-bridge for why this is polled rather than event-driven.

START=99
USE_PROCD=1

# The gate lives in a file this package ships. If it is ever not there, say so
# out loud: a service that silently stops starting is the failure this whole
# layer exists to avoid. Note the [ -r ] - sourcing a missing file ends the
# script outright in ash, so `if ! . file` would never reach its else branch.
if [ -r /usr/share/easymesh/boot-window.sh ]; then
	. /usr/share/easymesh/boot-window.sh
else
	logger -t mld-bsta-bridge "cannot read /usr/share/easymesh/boot-window.sh - refusing to start"
	is_mesh_node() { return 1; }
fi

start_service() {
	# A box nobody has made into a mesh node has no backhaul to bridge. The
	# test belongs here rather than in the worker: this is a respawn service,
	# so a worker that exits immediately is not quiet - it is a crash loop.
	# Measured 2026-08-17, six crashes in the first two minutes after the
	# guard was added one layer too low.
	is_mesh_node || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/mld-bsta-bridge watch
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
