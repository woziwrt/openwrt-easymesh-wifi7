#
# Which parent each backhaul should have, and - only with
# /etc/mapc/parent-steer-live - a measured trial of one move at a time.
# See /usr/sbin/easymesh-parent-plan. Controller only: it reads mapc.db.

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /etc/mapc/role 2>/dev/null)" = "controller" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/easymesh-parent-plan 300
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
