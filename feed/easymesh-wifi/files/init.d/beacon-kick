#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# Turn on the beacon of an AP-MLD link that hostapd never sent a second beacon
# set to. See /usr/sbin/beacon-kick for the night that found it and the two
# lines of mac80211 that explain it.
#
# START=99: it acts only on hostapd's control sockets, which do not exist until
# the radios are up, and it waits for them itself. Nothing at boot depends on
# it. Same placement as hostapd-watch, which watches the same daemon.

START=99
USE_PROCD=1

# The gate lives in a file this package ships. If it is ever not there, say so
# out loud - a service that silently stops starting is the failure this layer
# exists to avoid. Note the [ -r ]: sourcing a missing file ends the script
# outright in ash, so `if ! . file` would never reach its else branch.
if [ -r /usr/share/easymesh/boot-window.sh ]; then
	. /usr/share/easymesh/boot-window.sh
else
	logger -t beacon-kick "cannot read /usr/share/easymesh/boot-window.sh - refusing to start"
	is_mesh_node() { return 1; }
fi

start_service() {
	# An ordinary router has one AP per radio and no AP-MLD, so there is no
	# second beacon set for anyone to miss. Kicking beacons there would only
	# mean this package has an opinion about a box that never asked for one.
	is_mesh_node || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/beacon-kick
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
