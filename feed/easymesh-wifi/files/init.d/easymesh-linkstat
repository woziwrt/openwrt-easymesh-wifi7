#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# Per-leg liveness of the backhaul MLD. See /usr/sbin/easymesh-linkstat.
#
# START=99: it reads a bSTA that does not exist until the radios are up, and it
# waits for them itself. Same placement as beacon-kick, which watches the other
# side of the same air.

START=99
USE_PROCD=1

# [ -r ] rather than `if ! . file`: sourcing a missing file ends the script
# outright in ash, so the else branch would never be reached. Same trap
# beacon-kick documents ten lines further down its own file.
if [ -r /usr/share/easymesh/boot-window.sh ]; then
	. /usr/share/easymesh/boot-window.sh
else
	logger -t easymesh-linkstat "cannot read /usr/share/easymesh/boot-window.sh - refusing to start"
	is_mesh_node() { return 1; }
fi

start_service() {
	# A router nobody has made into a mesh node has no backhaul MLD and no
	# legs to count.
	is_mesh_node || return 0
	# The controller is the root and has no bSTA. The daemon would exit 0 at
	# once and procd would respawn it into a crash loop (2026-09-23 19:55,
	# both this and its sibling on the controller).
	[ -n "$(uci -q get wireless.sta_mld_1.ifname)" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/easymesh-linkstat 30
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
