# Forgets learned bridge entries when the backhaul tree changes, on this box
# and, through the controller, on every box. See /usr/sbin/easymesh-fdb-guard.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/easymesh-fdb-guard
	procd_set_param respawn
	procd_close_instance
}
