#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# Keep the log across a reboot. See /usr/sbin/easymesh-logkeep for the morning
# that made this necessary.
#
# Two instances rather than one process doing both jobs: the follower can then be
# exec'd as procd's own child, which is what keeps a restart from leaving an
# orphan appending into the previous boot's file.
#
# START=99: it records what others do and nothing at boot depends on it. It still
# catches the whole boot - logd buffers from the first line and logread replays
# that buffer, and tail is given -n +1 so it starts at the top of the file.

START=99
USE_PROCD=1

# The gate lives in a file this package ships. If it is ever not there, say so
# out loud: a service that silently stops starting is the failure this whole
# layer exists to avoid. Note the [ -r ] - sourcing a missing file ends the
# script outright in ash, so `if ! . file` would never reach its else branch.
if [ -r /usr/share/easymesh/boot-window.sh ]; then
	. /usr/share/easymesh/boot-window.sh
else
	logger -t easymesh-logkeep "cannot read /usr/share/easymesh/boot-window.sh - refusing to start"
	is_mesh_node() { return 1; }
fi

start_service() {
	# A router nobody has onboarded gets no files written into /root by this
	# package. Its logs are its own business.
	is_mesh_node || return 0

	procd_open_instance follow
	procd_set_param command /usr/sbin/easymesh-logkeep follow
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance cap
	procd_set_param command /usr/sbin/easymesh-logkeep cap
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
