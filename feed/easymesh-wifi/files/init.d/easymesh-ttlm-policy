#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# The TTLM policy producer. It reads mapc.db and writes /etc/mapc/ttlm-policy,
# so it runs where the database is - the controller - and nowhere else.
# Dry run until /etc/mapc/ttlm-policy-live exists; see /usr/sbin/easymesh-ttlm-policy.
#
# START=99: it reads bsta_link, which easymesh-linkstat-collect (also START=99)
# fills; the first passes simply find nothing fresh and pin nothing.

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /etc/mapc/role 2>/dev/null)" = "controller" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/easymesh-ttlm-policy 30
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
