# The backhaul MLD STA loses its 5 GHz leg to the AP's DFS CAC: the agent
# associates while the channel is still being checked for radar and stays
# single-linked. See /usr/sbin/mld-bsta-relink for the measurement.
#
# The helper does its own waiting (CAC is 60 s and starts ~30 s into boot) and
# runs for as long as the node does. procd keeps track of it: a restart used to
# leave the old loop running and start a second one next to it.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/mld-bsta-relink
	procd_close_instance
}
