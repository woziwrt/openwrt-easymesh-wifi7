#
# Recover an AP-MLD that lost a link to the boot race.
#
# hostapd can be handed a phy before netifd has created that radio's
# interfaces; the log shows "Interface wlanX wasn't started" followed by
# "hostapd.add_iface failed for phy phyN". The affected band is then simply
# absent from the MLD, and a plain "wifi reload" does not recover it - only a
# full down/up does. Observed on the 6 GHz radio of the BPI-R4 Pro 8X, 2026-07-21.
#
# Runs once per boot from /etc/init.d/mld-link-check. Does nothing at runtime:
# a wifi restart is far too blunt to trigger on a live mesh. That was the
# intent from the first version; it is enforced here since 2026-08-09, because
# a package upgrade turned out to be a second way in. See boot-window.sh.

. /usr/share/easymesh/boot-window.sh

# Nothing here belongs on a router nobody has made into a mesh node. See
# is_mesh_node() in boot-window.sh for what this cost on 2026-08-17.
is_mesh_node || exit 0

in_boot_window || {
	logger -t mld-link-check "started outside the boot window - skipping; a wifi restart is far too blunt for a live mesh"
	exit 0
}

RECHECK=15
# hostapd needs longer than a recheck to bring every link back after a restart;
# measuring too early makes the confirmation line under-report.
SETTLE_AFTER_RESTART=40
# Look again every POLL seconds for as long as the boot window lasts. One look
# at ~90 s was not enough: on the controller, map-agent restarts the wifi once
# more ~150 s into the boot, and on 2026-09-29 that second start handed hostapd
# an empty configuration for the 6 GHz radio - both AP MLDs came up without
# their 6 GHz link, every child of the controller joined on one leg, and this
# script had already looked and gone.
POLL=30

# Every AP MLD, not only the fronthaul: the backhaul one (mld1) lost its
# 6 GHz link the same way, and that is the one the mesh runs on.
# "<ifname> <links wanted>" per AP MLD whose wifi-iface lists several radios.
mlds() {
	for m in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-mld$/\1/p"); do
		[ "$(uci -q get wireless.$m.mode)" = ap ] || continue
		i=$(uci -q get wireless.$m.ifname)
		[ -n "$i" ] || continue
		for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)\.ifname='$i'$/\1/p"); do
			[ "$(uci -q get wireless.$s)" = wifi-iface ] || continue
			w=$(uci -q get wireless.$s.device | wc -w)
			[ "$w" -gt 1 ] 2>/dev/null && echo "$i $w"
			break
		done
	done
}

links() {
	ubus -t 5 call "wifi.apmld.$1" status 2>/dev/null | grep -c '"enabled": true'
}

# "<ifname> <have>/<want>" of every AP MLD short of links, nothing if none is
short() {
	mlds | while read -r i w; do
		h=$(links "$i")
		[ "$h" -lt "$w" ] 2>/dev/null && echo "$i $h/$w"
	done
}

while in_boot_window; do
	s=$(short)
	if [ -n "$s" ]; then
		# Confirm it is not merely slow before reaching for the hammer.
		sleep "$RECHECK"
		s=$(short)
		if [ -n "$s" ]; then
			logger -t mld-link-check "AP-MLD short of links: $(echo $s) - restarting wifi once"
			wifi down
			sleep 5
			wifi up
			sleep "$SETTLE_AFTER_RESTART"
			logger -t mld-link-check "after the restart: $(echo $(short)) (nothing listed = every AP MLD complete)"
			exit 0
		fi
	fi
	sleep "$POLL"
done
