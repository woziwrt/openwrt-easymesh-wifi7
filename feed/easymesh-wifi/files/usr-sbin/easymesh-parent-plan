#
# /usr/sbin/easymesh-parent-plan - which parent each backhaul SHOULD have.
#
# A backhaul picks its parent once, at association - the strongest beacon at
# that moment - and keeps it. After a power cut the mesh freezes in whatever
# shape the boot order gave it, and nobody ever goes back.
#
# This planner ranks every parent a node can hear by the estimated
# throughput of the WHOLE path to the controller through it: the node's own
# hop estimated from signal on 5 and 6 GHz, every hop above it from the rates
# its legs really run at, and the shared airtime of a single-channel mesh
# (each relay hop costs its airtime again). The model and its table are in
# /usr/share/easymesh/parent-plan.awk.
#
# Until 2026-09-27 it counted hops instead, and proposed kitchen, hall and
# corridor "2 -> 1 hops" straight onto the controller - kitchen at -76/-86 dBm
# with a 6 Mbit/s backhaul, where under corridor it had 432-720 Mbit/s.
#
# First aid is NOT this planner's job: a node that loses its parent scans and
# takes whatever it hears within ~30 s (wpa_supplicant). This only optimises
# afterwards, and only a node that has been on its parent for STABLE_S, onto
# a parent that has been up for STABLE_S - so a box that comes back gets its
# children back once it has proven itself, not while it is still booting.
#
# It moves a node only when one of two plain rules holds, and the candidate
# is >= MIN_GAIN_MBIT better:
#   A - its path estimate is below BAD_PATH_MBIT (the "no box on a leg under
#       ~100 Mbit/s" criterion) and the candidate is GAIN_PCT better
#       (RELAY_GAIN_PCT for a node with children - its whole subtree goes
#       dark while it moves);
#   B - the candidate is closer to the controller (fewer hops) and
#       CLOSER_GAIN_PCT better (RELAY_CLOSER_GAIN_PCT with children): a box
#       next to the controller hanging on one further out.
# The signal -> rate table is off by up to 1.7-3x (2026-09-27), so nothing
# finer than "half as good again" is trusted to it. That must hold in STREAK
# consecutive runs spanning at least HOLD_S, not
# within COOLDOWN of the node's last trial, and never onto a parent whose
# trial for this node failed within DENY_S. Never onto a parent without a
# path to the controller (an island - 2026-09-27, three boxes holding each
# other up with the controller knowing none of them), never onto a node below
# itself.
#
# It PLANS; it ACTS only when /etc/mapc/parent-steer-live exists, and then
# the move is decided by a measured trial on the node (easymesh-bh-trial),
# not by this estimate.
#
# When it runs: every PERIOD, and at once when the mesh changed - a node
# appeared, vanished or changed parent (one small query every TICK), or when
# someone touches $KICK. After such an event it plans every TICK for
# SETTLE_S, so the streak builds in minutes, not in quarter hours.
#
# Output: $OUT (the whole plan), the log (tag easymesh-parent-plan) for
# every newly proposed move:
#   [would ]NODE: MOVE OLD (depth D, S5/S6 dBm, T Mbit/s) -> NEW (depth D, S5/S6 dBm, T Mbit/s): why
# The events page parses that line; keep the positions of MOVE, "->" and the
# depth numbers.

PERIOD=${1:-300}
LIBDIR=${LIBDIR:-/usr/share/easymesh}
OUT=${OUT:-/tmp/easymesh/parent-plan.txt}
KICK=${KICK:-/tmp/easymesh/parent-plan.kick}
TICK=${TICK:-60}
SETTLE_S=${SETTLE_S:-900}
MAXAGE=${MAXAGE:-1500}          # a scan older than this is no candidate
LINK_FRESH=${LINK_FRESH:-120}   # a leg reported within this = node reachable
AGENT_FRESH=${AGENT_FRESH:-180} # a wired node heard within this = alive
BAD_PATH_MBIT=${BAD_PATH_MBIT:-100}
GAIN_PCT=${GAIN_PCT:-100}
RELAY_GAIN_PCT=${RELAY_GAIN_PCT:-200}
MIN_GAIN_MBIT=${MIN_GAIN_MBIT:-50}
CLOSER_GAIN_PCT=${CLOSER_GAIN_PCT:-50}
RELAY_CLOSER_GAIN_PCT=${RELAY_CLOSER_GAIN_PCT:-100}
STREAK=${STREAK:-3}
HOLD_S=${HOLD_S:-120}
STABLE_S=${STABLE_S:-300}
GHOST_S=${GHOST_S:-3600}      # an AL address unheard this long is a ghost
EFF=${EFF:-0.35}
MLO_FRAC=${MLO_FRAC:-0.25}

ROLE=${ROLE:-$(cat /etc/mapc/role 2>/dev/null)}
[ "$ROLE" = "controller" ] || exit 0
command -v sqlite3 >/dev/null || exit 1
[ -r "$LIBDIR/parent-plan.awk" ] || {
	logger -t easymesh-parent-plan "cannot read $LIBDIR/parent-plan.awk - refusing to start"
	exit 0
}

# db.sh, then names.sh (live_addrs_json) - the order easymesh-linkstat-collect
# documents. [ -r ] rather than `if ! . file`: sourcing a missing file ends the
# script outright in ash.
for _lib in db names rpc; do
	[ -r "$LIBDIR/$_lib.sh" ] || {
		logger -t easymesh-parent-plan "cannot read $LIBDIR/$_lib.sh - refusing to start"
		exit 0
	}
	# shellcheck source=/dev/null
	. "$LIBDIR/$_lib.sh"
done
unset _lib
# db.sh sets DB; the offline harness points it elsewhere with PLAN_DB
[ -n "$PLAN_DB" ] && DB=$PLAN_DB

LIVE=${LIVE:-/etc/mapc/parent-steer-live}
ST=${ST:-/tmp/easymesh/parent-steer}
# What a trial decided has to outlive a reboot of this box. Kept in /tmp,
# the 24 h deny and the cooldown vanished with every reflash of the
# controller, and on 2026-09-24 the planner tried kitchen -> controller
# again at 12:57 - the same move that had come back "reverted" at 05:51 -
# and the node spent the next twenty minutes looking for a parent. The
# running trial and the streaks stay in /tmp: neither survives a reboot
# in any meaningful way.
MEM=${MEM:-/etc/mapc/parent-steer}
COOLDOWN=${COOLDOWN:-3600}
DENY_S=${DENY_S:-86400}
TRIAL_MAX=${TRIAL_MAX:-420}
IPERF_PIDF=${IPERF_PIDF:-/tmp/easymesh/parent-steer-iperf.pid}
mkdir -p "${OUT%/*}" "$ST" "$MEM"

q() { sqlite3 -cmd ".timeout 3000" -separator ' ' "$DB" "$1" 2>/dev/null; }

# A BSSID -> the AP-MLD it belongs to. On these radios the 5 GHz link
# address IS the AP-MLD address; the 6 GHz link has its own and is found
# through affiliated_ap. Before 2026-09-27 only the first was looked up, so
# no 6 GHz signal ever reached a decision.
mld_of() {
	echo "(SELECT mm.mld_macaddr FROM apmld mm WHERE mm.mld_macaddr = $1
	   OR mm.mld_macaddr = (SELECT f.mld_macaddr FROM affiliated_ap f WHERE f.bssid = $1) LIMIT 1)"
}

# Every fact the decision needs, one line each - see parent-plan.awk.
gather() {
	now=$1
	echo "ROOT $ctrl"
	echo "NOW $now"
	q "SELECT 'N', almac, $now - ifnull(last_seen, 0) FROM agent;"
	q "SELECT 'C', b.agent_almac, a.agent_almac
	   FROM bstamld b JOIN apmld a ON a.mld_macaddr = b.ap_mld_macaddr
	   WHERE ifnull(b.ap_mld_macaddr, '') != '' AND b.agent_almac IS NOT NULL;"
	# 1905 media type: 0x00xx is IEEE 802.3, 0x01xx IEEE 802.11
	q "SELECT 'W', t.child_almac, t.parent_almac, $now - ifnull(a.last_seen, 0)
	   FROM topology_link t JOIN agent a ON a.almac = t.child_almac
	   WHERE t.media_type IS NOT NULL AND t.media_type < 256;"
	q "SELECT 'L', l.agent_almac, ifnull(l.band, 0), ifnull(l.state, 'unknown'),
	          ifnull(l.rssi, 0), ifnull(l.tx_mbit, 0), ifnull(l.rx_mbit, 0),
	          ifnull((SELECT m.agent_almac FROM apmld m WHERE m.mld_macaddr = $(mld_of l.bssid)), '-'),
	          $now - ifnull(l.last_seen, 0)
	   FROM bsta_link l;"
	q "SELECT 'S', c.agent_almac, m.agent_almac, m.mld_macaddr,
	          CASE WHEN c.freq > 5925 THEN 8 ELSE 2 END, c.signal,
	          $now - ifnull(c.scan_ts, 0)
	   FROM bh_candidate c JOIN apmld m ON m.mld_macaddr = $(mld_of c.bssid)
	   WHERE c.freq > 4900 AND m.agent_almac IS NOT NULL
	     AND m.agent_almac != c.agent_almac;"
	[ -r "$ST/state" ] && sed 's/^/X /' "$ST/state"
	for f in "$MEM"/last.*; do
		[ -r "$f" ] && echo "cool ${f##*/last.} $(cat "$f")"
	done
	for f in "$MEM"/deny.*; do
		[ -r "$f" ] || continue
		k=${f##*/deny.}
		echo "deny ${k%%.*} ${k#*.} $(cat "$f")"
	done
}

plan_once() {
	now=${NOW:-$(date +%s)}
	ctrl=${CTRL:-$(uci -q get ieee1905.ieee1905.macaddress | tr 'A-Z' 'a-z')}
	[ -n "$ctrl" ] || return 1

	rm -f "$ST/state.new" "$ST/ripe.new"
	: > "$ST/state.new"
	gather "$now" | awk -f "$LIBDIR/parent-plan.awk" \
		-v statef="$ST/state.new" -v ripef="$ST/ripe.new" \
		-v maxage="$MAXAGE" -v linkfresh="$LINK_FRESH" -v agentfresh="$AGENT_FRESH" \
		-v gain="$GAIN_PCT" -v relaygain="$RELAY_GAIN_PCT" -v mingain="$MIN_GAIN_MBIT" -v badpath="$BAD_PATH_MBIT" \
		-v closer="$CLOSER_GAIN_PCT" -v relaycloser="$RELAY_CLOSER_GAIN_PCT" \
		-v streak="$STREAK" -v hold="$HOLD_S" -v stable="$STABLE_S" -v ghostage="$GHOST_S" \
		-v cooldown="$COOLDOWN" -v denys="$DENY_S" \
		-v eff="$EFF" -v mlofrac="$MLO_FRAC" | sort > "$OUT.tmp" || return 1
	sed 's/^X //' "$ST/state.new" > "$ST/state"
	# ripe moves, the largest gain first
	if [ -s "$ST/ripe.new" ]; then sort -k6 -nr "$ST/ripe.new" > "$ST/ripe"; else rm -f "$ST/ripe"; fi
	rm -f "$ST/state.new" "$ST/ripe.new"

	# Log a proposal when it is new, not every run: in settle mode this runs
	# every minute. The events page folds repeats within a day anyway.
	grep ": MOVE " "$OUT.tmp" | sed 's/^\([^ ]*\): MOVE \([^ ]*\) .* -> \([^ ]*\) .*/\1 \3/' | sort > "$ST/proposed.new"
	grep ": MOVE " "$OUT.tmp" | while read -r l; do
		k=$(echo "$l" | sed 's/^\([^ ]*\): MOVE \([^ ]*\) .* -> \([^ ]*\) .*/\1 \3/')
		grep -qxF "$k" "$ST/proposed" 2>/dev/null && continue
		if [ -e "$LIVE" ]; then logger -t easymesh-parent-plan "proposed $l"
		else logger -t easymesh-parent-plan "would $l"; fi
	done
	mv "$ST/proposed.new" "$ST/proposed"
	mv "$OUT.tmp" "$OUT"
	return 0
}

# Who is alive and whose child it is, in one line: when this changes, the
# mesh changed (a box vanished, returned, or a node re-attached by itself).
fingerprint() {
	q "SELECT group_concat(x, ',') FROM (SELECT DISTINCT l.agent_almac || '>' || ifnull(b.ap_mld_macaddr, '') AS x
	   FROM bsta_link l LEFT JOIN bstamld b ON b.agent_almac = l.agent_almac
	   WHERE $(date +%s) - l.last_seen < $LINK_FRESH ORDER BY 1);"
}


# ---------------------------------------------------------------------------
# Acting on the plan - only with /etc/mapc/parent-steer-live present.
#
# A plan is an estimate; the move itself is decided by a measured trial on
# the node (easymesh-bh-trial), which keeps it only when it paid and
# otherwise goes back on its own. Here only the guard rails:
#   - only a ripe move (see the awk: streak, hold, cooldown, deny),
#   - one trial in the whole mesh at a time, with an iperf3 server on this
#     controller only for its duration.
# The trial pins the target's AP-MLD address with wpa_cli on the node itself,
# so - unlike steer_backhaul through map-controller - it works for a target
# the controller has not learned a backhaul BSS for (a node with no children
# after a controller restart, 2026-09-27).
# ---------------------------------------------------------------------------

steer_log() { logger -t easymesh-parent-steer "$*"; }

ask_p() {
	# ask_p <ip> <method> <json-params>
	_s=$(mesh_rpc_session "$1") || return 1
	curl -s --max-time 5 -X POST -H 'Content-Type: application/json' \
		-d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"call\",\"params\":[\"$_s\",\"easymesh\",\"$2\",$3]}" \
		"http://$1/ubus" 2>/dev/null | jsonfilter -e '@.result[1]'
}

ip_of() {
	live_addrs_json | tr -d '{}"' | tr ',' '\n' |
		sed -n "s/^$1:\([0-9.]*\)$/\1/p" | head -1
}

iperf_stop() {
	[ -s "$IPERF_PIDF" ] && kill "$(cat "$IPERF_PIDF")" 2>/dev/null
	rm -f "$IPERF_PIDF"
}

# The last trials, for LuCI (Backhaul & MLO), kept across reboots. Written
# whole into a new file and moved over the old one: appended in place, a
# power cut could leave half a line on the flash, and one broken line made
# the whole answer invalid JSON (review, 2026-09-29).
trial_record() {
	{
		grep '^{.*}$' "$MEM/trials.jsonl" 2>/dev/null | tail -n 19
		printf '{"ts":%s,"child":"%s","parent":"%s","verdict":"%s","base":[%s],"trial":[%s]}\n' \
			"$now" "$child" "$parent" "$1" "$2" "$3"
	} > "$MEM/trials.jsonl.$$" && mv "$MEM/trials.jsonl.$$" "$MEM/trials.jsonl"
}

steer_once() {
	now=$(date +%s)
	# 1. a trial in flight: wait for it, record it, let go of the server
	if [ -s "$ST/running" ]; then
		{ read -r child parent target ip started; read -r line; } < "$ST/running"
		r=$(ask_p "$ip" bh_trial_state '{}')
		if echo "$r" | grep -q '"verdict"'; then
			v=$(echo "$r" | jsonfilter -e '@.verdict')
			steer_log "trial $child -> $parent ($target): $v ($r)"
			# Keyed by the parent's AL address, as the planner reads it.
			# Until 2026-09-27 this was written under the target BSSID and
			# read under the AL address, so a failed trial never denied
			# anything.
			# what the trial measured (up/down, Mbit/s), for Events and LuCI
			m=""
			_bu=$(echo "$r" | jsonfilter -e '@.base[0]' 2>/dev/null); _bd=$(echo "$r" | jsonfilter -e '@.base[1]' 2>/dev/null)
			_tu=$(echo "$r" | jsonfilter -e '@.trial[0]' 2>/dev/null); _td=$(echo "$r" | jsonfilter -e '@.trial[1]' 2>/dev/null)
			[ -n "$_bu" ] && [ -n "$_tu" ] && m=" [measured $_bu/$_bd -> $_tu/$_td Mbit/s up/down]"
			case "$line" in
			"HAND "*)
				# asked for in LuCI: the user decided to try it, so a move
				# that did not pay denies nothing - they may ask again
				if [ "$v" = kept ]; then
					logger -t easymesh-parent-plan "handkept ${line#HAND } - kept after a measured trial$m"
				else
					logger -t easymesh-parent-plan "handback ${line#HAND } - went back, it was not faster ($v)$m"
				fi ;;
			*)
				if [ "$v" = kept ]; then
					logger -t easymesh-parent-plan "$line - kept after a measured trial$m"
				else
					echo "$now" > "$MEM/deny.$child.$parent"
					logger -t easymesh-parent-plan "reverted $line - the trial did not pay ($v)$m"
				fi ;;
			esac
			trial_record "$v" "${_bu:+$_bu,$_bd}" "${_tu:+$_tu,$_td}"
			echo "$now" > "$MEM/last.$child"
			rm -f "$ST/running"; iperf_stop
		elif [ $((now - started)) -gt "$TRIAL_MAX" ]; then
			steer_log "trial $child -> $parent: no result after ${TRIAL_MAX}s ($r) - giving up"
			trial_record timeout "" ""
			echo "$now" > "$MEM/deny.$child.$parent"; echo "$now" > "$MEM/last.$child"
			rm -f "$ST/running"; iperf_stop
		fi
		return 0
	fi

	[ -e "$LIVE" ] || return 0
	[ -s "$ST/ripe" ] || return 0

	# 2. the ripe move with the largest gain; the awk already applied the
	#    streak, cooldown and deny
	read -r child parent target cur new pct < "$ST/ripe"
	line=$(grep "^$child: MOVE " "$OUT" | head -1)
	ip=$(ip_of "$child")
	ctrl_ip=$(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet /{ sub(/\/.*/, "", $2); print $2; exit }')
	[ -n "$target" ] && [ -n "$ip" ] && [ -n "$ctrl_ip" ] || {
		steer_log "cannot try $child -> $parent: target '$target' ip '$ip' controller '$ctrl_ip'"
		echo "$now" > "$MEM/last.$child"
		return 0
	}
	iperf3 -s -p 5203 -D --pidfile "$IPERF_PIDF" 2>/dev/null
	r=$(ask_p "$ip" bh_trial "{\"target\":\"$target\",\"controller\":\"$ctrl_ip\"}")
	# By field, not by text: jsonfilter prints { "started": true } with a
	# space, and a grep for '"started":true' called every started trial
	# "refused" - 2026-09-23, the first live one.
	if [ "$(echo "$r" | jsonfilter -e '@.started' 2>/dev/null)" = true ]; then
		printf '%s %s %s %s %s\n%s\n' "$child" "$parent" "$target" "$ip" "$now" "$line" > "$ST/running"
		steer_log "trial started: $child ($ip) -> $parent via $target (estimate $cur -> $new Mbit/s, $pct %)"
		logger -t easymesh-parent-plan "trying $line"
	else
		steer_log "trial for $child refused: $r"
		iperf_stop; echo "$now" > "$MEM/last.$child"
	fi
	return 0
}

# easymesh-parent-plan try <child-al> <parent-al> - a trial asked for by hand
# (LuCI, "Move..."). The same measured trial as the planner's own, through
# the same path: one trial in the mesh at a time, measured before and after,
# back by itself if it does not pay. It runs whether the planner is live or
# not - the user chose it - and this loop records the verdict. Prints one
# JSON line for the API.
if [ "$1" = try ]; then
	child=$(echo "$2" | tr 'A-Z' 'a-z'); parent=$(echo "$3" | tr 'A-Z' 'a-z'); now=$(date +%s)
	no() { printf '{"started":false,"error":"%s"}\n' "$1"; exit 0; }
	[ -s "$ST/running" ] && no "another move is being tried right now - wait until it has finished"
	cur=$(q "SELECT parent_almac FROM topology_link WHERE child_almac = '$child' LIMIT 1;")
	[ -n "$cur" ] || no "this box has no backhaul parent in the database"
	[ "$cur" = "$parent" ] && no "it is already there"
	# the parent's backhaul AP MLD as the box heard it in its last scan
	target=$(q "SELECT m.mld_macaddr FROM bh_candidate c JOIN apmld m ON m.mld_macaddr = $(mld_of c.bssid)
		WHERE c.agent_almac = '$child' AND m.agent_almac = '$parent' AND c.freq > 4900 LIMIT 1;")
	[ -n "$target" ] || no "the box has not heard that parent in its last scan"
	ip=$(ip_of "$child")
	ctrl_ip=$(ip -4 addr show dev br-lan 2>/dev/null | awk '/inet /{ sub(/\/.*/, "", $2); print $2; exit }')
	[ -n "$ip" ] && [ -n "$ctrl_ip" ] || no "cannot reach the box over the mesh"
	iperf3 -s -p 5203 -D --pidfile "$IPERF_PIDF" 2>/dev/null
	r=$(ask_p "$ip" bh_trial "{\"target\":\"$target\",\"controller\":\"$ctrl_ip\"}")
	if [ "$(echo "$r" | jsonfilter -e '@.started' 2>/dev/null)" = true ]; then
		printf '%s %s %s %s %s\n%s\n' "$child" "$parent" "$target" "$ip" "$now" "HAND $child: MOVE $cur -> $parent" > "$ST/running"
		steer_log "trial started by hand: $child ($ip) -> $parent via $target"
		logger -t easymesh-parent-plan "handtry $child: MOVE $cur -> $parent - a measured trial asked for in LuCI"
		touch "$KICK"
		printf '{"started":true}\n'
	else
		iperf_stop
		no "the box refused: $(echo "$r" | jsonfilter -e '@.error' 2>/dev/null)"
	fi
	exit 0
fi

if [ "${ONESHOT:-0}" = 1 ]; then
	plan_once; cat "$OUT"; exit 0
fi
if [ "${ONESHOT:-0}" = 2 ]; then
	plan_once && steer_once; cat "$OUT"; exit 0
fi

last=0; settle=0; fp_old=""
while :; do
	now=$(date +%s)
	fp=$(fingerprint)
	ev=0
	[ -e "$KICK" ] && { rm -f "$KICK"; ev=1; }
	[ -n "$fp_old" ] && [ "$fp" != "$fp_old" ] && ev=1
	fp_old=$fp
	[ "$ev" = 1 ] && settle=$((now + SETTLE_S))
	if [ "$ev" = 1 ] || [ "$now" -lt "$settle" ] || [ $((now - last)) -ge "$PERIOD" ]; then
		plan_once && steer_once
		last=$now
	fi
	sleep "$TICK"
done
