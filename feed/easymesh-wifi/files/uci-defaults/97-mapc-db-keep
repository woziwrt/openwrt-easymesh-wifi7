#
# /etc/uci-defaults/97-mapc-db-keep
#
# What of /etc/mapc a sysupgrade keeps is decided by
# /lib/upgrade/easymesh-add-conffiles.sh: an explicit list, with the database
# checkpointed into one file first. Until 2026-09-30 this script put the whole
# /etc/mapc/ into /etc/sysupgrade.conf - database copied mid-write, logs,
# captures and lab switches included - so the line it left there is removed.
#
# The names the owner typed into the controller (/etc/mesh-node-names) are
# kept by the same hook.

sed -i '\#^/etc/mapc/$#d' /etc/sysupgrade.conf 2>/dev/null
exit 0
