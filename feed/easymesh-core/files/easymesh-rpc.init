#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
#
# The rpcd user the boxes of the mesh log in to each other with
# (/usr/share/easymesh/rpc.sh). Its password follows the backhaul key; this
# brings it up to date at every boot, before rpcd and uhttpd take requests.

START=11

boot() {
	. /usr/share/easymesh/rpc.sh
	mesh_rpc_user
}

start() {
	boot
}
