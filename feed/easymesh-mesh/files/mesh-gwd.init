#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (C) 2026 Petr Wozniak (WOZIWRT project)
# Start mesh-gwd, the daemon that keeps the internet gateway on whichever
# node holds the ISP cable.
#
# ⚠️ This header used to claim the service was "disabled by default". It never
# was. Nothing implemented that - base-files default_postinst enables every
# init script a package ships - so easymesh-role's `/etc/init.d/mesh-gwd enable`
# was enabling something already enabled, and the daemon ran on every box the
# image was ever flashed to. Measured on hardware 2026-08-18: running on a
# freshly flashed board with no role, announcing VIP=10.10.10.254 on br-lan.
#
# It did no damage there, and not by luck: it refuses to claim an address
# somebody already answers for, and that board had no uplink of its own. But a
# factory box carried into a mesh before anyone gives it a role has both of
# those the other way round, and then it is a second holder of the gateway
# address - which is the one failure this daemon exists to prevent.
#
# The gate is sourced only if the EasyMesh wifi layer is installed. This package
# is the L3 layer and stands on its own: on a box without that layer there is no
# mesh role to have, and mesh-gwd keeps behaving exactly as it did. The mark is
# deliberately not spelled out a second time here - it is defined once, in
# is_mesh_node(), and three earlier gates went wrong by each keeping their own
# copy of what it meant.
START=98
STOP=10
USE_PROCD=1

[ -r /usr/share/easymesh/boot-window.sh ] && . /usr/share/easymesh/boot-window.sh

start_service() {
	command -v is_mesh_node >/dev/null && { is_mesh_node || return 0; }
	procd_open_instance
	procd_set_param command /usr/sbin/mesh-gwd
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
